# Flexy HRMS API — environment variables
# Copy to `.env` and adjust for your environment. DATABASE_URL is mandatory.
# All other variables have safe defaults and are optional in development.

# --- Database (Prisma / PostgreSQL) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/flexy_hrms?schema=public"

# --- Server ---
PORT=3000
# Comma-separated allowlist. NEVER use "*" in production with credentials.
CORS_ORIGIN="http://localhost:3001"

# --- Auth / JWT ---
# Use strong, unique secrets in production (min 32 chars — server refuses to start otherwise).
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-to-a-different-long-random-secret"
JWT_REFRESH_EXPIRES_IN="7d"
# Public self-registration. Default CLOSED; only open explicitly if needed.
ALLOW_PUBLIC_REGISTER="false"

# --- At-rest encryption (AES-256-GCM, min 32 chars) ---
# Required in production (used for salary / medical ID encryption).
DATA_ENCRYPTION_KEY="change-me-to-a-long-random-encryption-key"

# --- Rate limiting (Nest Throttler) ---
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# --- Attendance / Geofencing ---
GEOFENCE_RADIUS_METERS=100
OVERTIME_MIN_MINUTES=30

# --- Background job worker ---
# Set to "false" on secondary instances if you run the worker on a single node only.
JOB_WORKER_ENABLED="true"

# --- Multi-tenancy ---
# Tenant isolation is enforced by the `x-tenant-id` request header (default "default").
#
# Defense-in-depth (DB-level Row-Level Security). Opt-in: apply scripts/rls.sql
# first, then enable. When true, each DB operation runs in a transaction that sets
# the session tenant GUC so RLS policies filter by tenant at the database level.
# Validate on a non-prod DB (incl. a cross-tenant x-tenant-id attempt) before prod.
DB_RLS_ENABLED="false"
#
# At-rest encryption of Employment.salary (F-05). Opt-in: apply
# scripts/employment-salary-enc.sql first, then enable. When true, the Prisma
# middleware encrypts salary into the salary_enc column on write and decrypts it
# back into `salary` on read (ciphertext is never returned to clients).
SALARY_ENCRYPTION_ENABLED="false"
