{
  "expo": {
    "name": "Flexy HRMS",
    "slug": "flexy-hrms-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1e3a8a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.flexyhrms.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "Aplikasi memerlukan akses kamera untuk verifikasi wajah (absensi biometrik)",
        "NSLocationWhenInUseUsageDescription": "Aplikasi memerlukan akses lokasi GPS untuk verifikasi lokasi absensi",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Aplikasi memerlukan akses lokasi latar belakang untuk pelacakan lokasi karyawan lapangan",
        "NSFaceIDUsageDescription": "Aplikasi menggunakan Face ID untuk keamanan aplikasi"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1e3a8a",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.flexyhrms.mobile",
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ],
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-camera",
      "expo-location",
      "expo-face-detector",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Aplikasi memerlukan akses galeri untuk memilih foto profil"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "flexy-hrms-mobile"
      }
    }
  }
}