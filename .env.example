# Copy to .env and fill with real secrets (never commit .env)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/flexy_hrms
JWT_SECRET=change-me-min-32-chars-long-secret-please
JWT_REFRESH_SECRET=change-me-min-32-chars-refresh-secret-please
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
DATA_ENCRYPTION_KEY=change-me-min-32-chars-encryption-key-please
CORS_ORIGIN=http://localhost:3001
PORT=3000
ALLOW_PUBLIC_REGISTER=false
NODE_ENV=development
