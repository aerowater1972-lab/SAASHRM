// =======================================================================
// TASK & PROJECT MANAGEMENT (GAP-02)
// =======================================================================

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum ProjectPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ProjectMemberRole {
  OWNER
  MANAGER
  MEMBER
  VIEWER
}

enum ProjectTaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  BLOCKED
}

enum ProjectTaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Project {
  id          String          @id @default(uuid())
  tenantId    String
  name        String
  code        String
  description String?
  status      ProjectStatus   @default(PLANNING)
  priority    ProjectPriority @default(MEDIUM)
  ownerUserId String
  departmentId String?
  startDate   DateTime?
  endDate     DateTime?
  color       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deletedAt   DateTime?

  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  owner      User            @relation("project_owner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  department Department?     @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  members    ProjectMember[]
  tasks      Task[]
  timesheetEntries TimesheetEntry[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([tenantId, ownerUserId])
}

model ProjectMember {
  id         String            @id @default(uuid())
  tenantId   String
  projectId  String
  employeeId String
  role       ProjectMemberRole @default(MEMBER)
  createdAt  DateTime          @default(now())

  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([projectId, employeeId])
  @@index([tenantId])
  @@index([employeeId])
}

model Task {
  id               String        @id @default(uuid())
  tenantId         String
  projectId        String?
  title            String
  description      String?
  status           ProjectTaskStatus    @default(TODO)
  priority         ProjectTaskPriority  @default(MEDIUM)
  assigneeEmployeeId String?
  reporterUserId   String
  dueDate          DateTime?
  estimateHours    Decimal?      @db.Decimal(8, 2)
  loggedHours      Decimal?      @db.Decimal(8, 2)
  tags             String[]      @default([])
  parentTaskId     String?
  completedAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?

  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  project   Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee  Employee?     @relation("task_assignee", fields: [assigneeEmployeeId], references: [id], onDelete: SetNull)
  reporter  User          @relation("task_reporter", fields: [reporterUserId], references: [id], onDelete: Restrict)
  parent    Task?         @relation("task_subtasks", fields: [parentTaskId], references: [id], onDelete: SetNull)
  subtasks  Task[]        @relation("task_subtasks")
  comments  TaskComment[]
  blockedBy TaskDependency[] @relation("task_blocked_by")
  blocking  TaskDependency[] @relation("task_blocking")
  timesheetEntries TimesheetEntry[]

  @@index([tenantId, status])
  @@index([tenantId, projectId])
  @@index([tenantId, assigneeEmployeeId])
  @@index([tenantId, reporterUserId])
  @@index([assigneeEmployeeId])
  @@index([parentTaskId])
  @@index([tenantId, dueDate])
}

model TaskComment {
  id               String   @id @default(uuid())
  tenantId         String
  taskId           String
  authorEmployeeId String?
  authorUserId     String?
  content          String
  createdAt        DateTime @default(now())

  tenant         Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  task           Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorEmployee Employee?  @relation(fields: [authorEmployeeId], references: [id], onDelete: SetNull)
  authorUser     User?      @relation(fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
  @@index([tenantId])
}

// Task dependency graph (TM-04 Gantt): task tidak bisa DONE sebelum blocker DONE.
model TaskDependency {
  id              String             @id @default(uuid())
  tenantId        String
  taskId          String
  dependsOnTaskId String
  type            TaskDependencyType @default(FINISH_TO_START)
  createdAt       DateTime           @default(now())

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  task      Task   @relation("task_blocked_by", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn Task   @relation("task_blocking", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)

  @@unique([tenantId, taskId, dependsOnTaskId])
  @@index([tenantId, taskId])
  @@index([dependsOnTaskId])
}

enum TaskDependencyType {
  FINISH_TO_START
  START_TO_START
  FINISH_TO_FINISH
}

// =======================================================================
// TIMESHEET (attendance x tasks) — gap parity "Timesheet Management"
// Satu baris per karyawan per hari per tugas; diagregasi jadi grid mingguan.
// Terikat periode absensi/payroll: entri pada periode CLOSED/LOCKED dikunci.
// =======================================================================
enum TimesheetStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

model TimesheetEntry {
  id          String           @id @default(uuid())
  tenantId    String
  employeeId  String
  taskId      String?
  projectId   String?
  workDate    DateTime // date-only (midnight) hari kerja
  hours       Decimal          @db.Decimal(5, 2)
  description String?
  billable    Boolean          @default(true)
  status      TimesheetStatus  @default(DRAFT)
  approvedBy  String?
  approvedAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  task     Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  project  Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@unique([employeeId, taskId, workDate])
  @@index([tenantId, workDate])
  @@index([tenantId, employeeId, workDate])
  @@index([tenantId, projectId, workDate])
  @@index([taskId])
}


// =======================================================================
// INTERNAL COMMUNICATION HUB / FORUM (GAP-03)
// Spesifikasi: gaps-audit/03-deep-dive.md (GAP-03)
// feed: timeline pinned + chronological, filter department/topic/type,
// rich content, reactions, nested comments (maks 3 level).
// Thread types: ANNOUNCEMENT (admin-only create), DISCUSSION, POLL, EVENT.
// Moderasi: pin/lock (admin), report queue, delete/edit (admin atau author).
// =======================================================================

model ForumThread {
  id             String            @id @default(uuid())
  tenantId       String
  authorUserId   String
  type           ForumThreadType   @default(DISCUSSION)
  title          String?
  content        String            @db.Text
  attachments    Json              @default("[]")
  visibility     ForumVisibility   @default(PUBLIC)
  departmentId   String?
  pollOptions    Json?
  eventDate      DateTime?
  eventLocation  String?
  isPinned       Boolean           @default(false)
  isLocked       Boolean           @default(false)
  viewCount      Int               @default(0)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deletedAt      DateTime?

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  author     User        @relation(fields: [authorUserId], references: [id], onDelete: Restrict)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  comments   ForumComment[]
  reactions  ForumReaction[]
  mentions   ForumMention[]
  reports    ForumReport[]

  @@index([tenantId, isPinned(sort: Desc), createdAt(sort: Desc)])
  @@index([tenantId, type])
  @@index([tenantId, departmentId])
  @@index([tenantId, authorUserId])
}

model ForumComment {
  id              String   @id @default(uuid())
  tenantId        String
  threadId        String
  parentCommentId String?
  authorUserId    String
  content         String   @db.Text
  attachments     Json     @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  thread   ForumThread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  parent   ForumComment? @relation("forum_nested_comments", fields: [parentCommentId], references: [id], onDelete: SetNull)
  replies  ForumComment[] @relation("forum_nested_comments")
  reactions ForumReaction[]
  author   User          @relation(fields: [authorUserId], references: [id], onDelete: Restrict)
  mentions ForumMention[]
  reports  ForumReport[]

  @@index([threadId, createdAt])
  @@index([tenantId])
  @@index([parentCommentId])
}

model ForumReaction {
  id           String            @id @default(uuid())
  tenantId     String
  targetType   ForumTargetType
  threadId     String?
  commentId    String?
  userId       String
  reactionType ForumReactionType @default(LIKE)
  createdAt    DateTime          @default(now())

  tenant  Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  thread  ForumThread? @relation(fields: [threadId], references: [id], onDelete: Cascade)
  comment ForumComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([targetType, threadId, commentId, userId, reactionType])
  @@index([tenantId, targetType])
  @@index([threadId])
  @@index([commentId])
}

model ForumMention {
  id               String   @id @default(uuid())
  tenantId         String
  threadId         String?
  commentId        String?
  mentionedUserId  String?
  mentionedEmployeeId String?
  isRead           Boolean  @default(false)
  createdAt        DateTime @default(now())

  tenant            Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  thread            ForumThread? @relation(fields: [threadId], references: [id], onDelete: Cascade)
  comment           ForumComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  mentionedEmployee Employee?    @relation(fields: [mentionedEmployeeId], references: [id], onDelete: SetNull)

  @@index([tenantId, mentionedEmployeeId, isRead])
  @@index([threadId])
  @@index([commentId])
}

model ForumReport {
  id         String            @id @default(uuid())
  tenantId   String
  targetType ForumTargetType
  threadId   String?
  commentId  String?
  reportedBy String
  reason     String            @db.Text
  status     ForumReportStatus @default(PENDING)
  reviewedBy String?
  reviewedAt DateTime?
  createdAt  DateTime          @default(now())

  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  thread   ForumThread? @relation(fields: [threadId], references: [id], onDelete: Cascade)
  comment  ForumComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reporter User         @relation("forum_reporter", fields: [reportedBy], references: [id], onDelete: Restrict)
  reviewer User?        @relation("forum_reviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([tenantId, status, createdAt(sort: Desc)])
  @@index([threadId])
  @@index([commentId])
}

enum ForumThreadType {
  ANNOUNCEMENT
  DISCUSSION
  POLL
  EVENT
}

enum ForumVisibility {
  PUBLIC
  DEPARTMENT
  ROLE
}

enum ForumTargetType {
  THREAD
  COMMENT
}

enum ForumReactionType {
  LIKE
  LOVE
  CELEBRATE
  INSIGHTFUL
  CURIOUS
}

enum ForumReportStatus {
  PENDING
  REVIEWED
  ACTIONED
  DISMISSED
}

// =======================================================================
// COMPENSATION MANAGEMENT (GAP-06 / Epic 2.1 roadmap)
// Spesifikasi: gaps-audit/03-deep-dive.md (GAP-06), tasks: 02-roadmap.md CM-01..CM-06
// Salary structure builder (grade + job family + min/mid/max), review cycle
// (bulk/individual adjustment + approval), internal equity analysis
// (compa-ratio), total rewards view, sync approved adjustment ke payroll.
// =======================================================================

model CompSalaryStructure {
  id            String   @id @default(uuid())
  tenantId      String
  jobFamily     String
  grade         String
  minSalary     Decimal  @db.Decimal(18, 2)
  midSalary     Decimal  @db.Decimal(18, 2)
  maxSalary     Decimal  @db.Decimal(18, 2)
  currency      String   @default("IDR")
  effectiveDate DateTime @db.Date
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, jobFamily, grade, effectiveDate])
  @@index([tenantId, jobFamily])
  @@index([tenantId, effectiveDate])
}

model CompReviewCycle {
  id               String              @id @default(uuid())
  tenantId         String
  name             String
  type             CompReviewCycleType @default(ANNUAL)
  status           CompReviewStatus    @default(DRAFT)
  effectiveDate    DateTime            @db.Date
  totalBudget      Decimal?            @db.Decimal(18, 2)
  allocatedBudget  Decimal             @default(0) @db.Decimal(18, 2)
  createdBy        String
  approvedBy       String?
  createdAt        DateTime            @default(now())
  approvedAt       DateTime?
  deletedAt        DateTime?

  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  creator    User          @relation("comp_cycle_creator", fields: [createdBy], references: [id], onDelete: Restrict)
  approver   User?         @relation("comp_cycle_approver", fields: [approvedBy], references: [id], onDelete: SetNull)
  adjustments CompAdjustment[]

  @@index([tenantId, status])
  @@index([tenantId, effectiveDate])
}

model CompAdjustment {
  id                   String                @id @default(uuid())
  tenantId             String
  reviewCycleId        String?
  employeeId           String
  currentSalary        Decimal               @db.Decimal(18, 2)
  proposedSalary       Decimal               @db.Decimal(18, 2)
  adjustmentType       CompAdjustmentType    @default(MERIT)
  adjustmentPercentage Decimal?              @db.Decimal(7, 2)
  reason               String?               @db.Text
  status               CompAdjustmentStatus  @default(PENDING)
  approvedBy           String?
  approvedAt           DateTime?
  effectiveDate        DateTime              @db.Date
  syncedToPayroll      Boolean               @default(false)
  syncedAt             DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  reviewCycle CompReviewCycle? @relation(fields: [reviewCycleId], references: [id], onDelete: SetNull)
  employee    Employee         @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  approver    User?            @relation("comp_adjustment_approver", fields: [approvedBy], references: [id], onDelete: SetNull)

  @@index([reviewCycleId, status])
  @@index([tenantId, employeeId])
  @@index([tenantId, status])
  @@index([tenantId, effectiveDate])
}

enum CompReviewCycleType {
  ANNUAL
  MID_YEAR
  PROMOTION
  AD_HOC
}

enum CompReviewStatus {
  DRAFT
  OPEN
  IN_REVIEW
  APPROVED
  APPLIED
  CLOSED
  CANCELLED
}

enum CompAdjustmentType {
  MERIT
  PROMOTION
  MARKET_ADJUST
  COLA
}

enum CompAdjustmentStatus {
  PENDING
  APPROVED
  REJECTED
  APPLIED
  CANCELLED
}

// =======================================================================
// QW-01 — SCHEDULED REPORT (auto-email laporan terjadwal)
// Pengguna menjadwalkan laporan analytics (CSV/PDF) yang dikirim otomatis
// ke daftar email pada interval harian/mingguan/bulanan.
// =======================================================================

enum ScheduledReportFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

enum ScheduledReportStatus {
  IDLE
  SUCCESS
  FAILED
}

model ScheduledReport {
  id         String                   @id @default(uuid())
  tenantId   String
  name       String
  report     String // analytics report key (headcount, turnover, ...)
  format     String                   @default("csv") // csv | pdf
  frequency  ScheduledReportFrequency @default(DAILY)
  hour       Int                      @default(7) // jam kirim 0-23
  dayOfWeek  Int? // 0=Minggu..6=Sabtu (WEEKLY)
  dayOfMonth Int? // 1-28 (MONTHLY)
  recipients String[] // daftar email tujuan
  filters    Json? // snapshot AnalyticsFilterDto
  isActive   Boolean                  @default(true)
  nextRunAt  DateTime?
  lastRunAt  DateTime?
  lastStatus ScheduledReportStatus    @default(IDLE)
  lastError  String?
  createdBy  String?
  createdAt  DateTime                 @default(now())
  updatedAt  DateTime                 @updatedAt

  @@index([tenantId, isActive])
  @@index([isActive, nextRunAt])
}


// =======================================================================
// OPEN API � Webhook Engine (OA-03, GAP-18)
// =======================================================================

enum WebhookDeliveryStatus {
  PENDING // menunggu dikirim
  DELIVERED // endpoint membalas 2xx
  FAILED // gagal setelah semua retry habis
}

model WebhookEndpoint {
  id          String   @id @default(uuid())
  tenantId    String
  url         String // tujuan HTTP POST
  description String?
  // Daftar event yang disubscribe (mis. "leave.approved"). Gunakan ["*"] untuk semua.
  events      String[]
  // Secret HMAC (disimpan sebagai hash sha256; plaintext hanya ditampilkan sekali saat dibuat).
  secretHash  String
  isActive    Boolean  @default(true)
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  deliveries WebhookDelivery[]

  @@index([tenantId, isActive])
}

model WebhookDelivery {
  id          String                @id @default(uuid())
  tenantId    String
  endpointId  String
  event       String // nama domain event
  payload     Json
  status      WebhookDeliveryStatus @default(PENDING)
  attempts    Int                   @default(0)
  nextRetryAt DateTime?
  deliveredAt DateTime?
  responseStatus Int?
  responseBody   String?
  errorMsg       String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([status, nextRetryAt])
  @@index([endpointId, createdAt])
  @@index([tenantId, createdAt])
}

model ApiKey {
  id         String    @id @default(uuid())
  tenantId   String
  name       String
  keyHash    String    @unique // sha256 hash of the API key
  keyPrefix  String // first 12 chars for display
  scopes     String[]  @default(["*"])
  lastUsedAt DateTime?
  expiresAt  DateTime?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  @@index([tenantId, isActive])
  @@index([keyHash])
}

model SandboxEnvironment {
  id             String   @id @default(uuid())
  tenantId       String
  status         String   @default("active")
  sampleType     String
  recordsCreated Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([tenantId, createdAt])
}

