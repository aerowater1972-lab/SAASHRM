// =======================================================================
// PLATFORM OPERATIONS - Multi-Tenant Monitoring
// =======================================================================
// PLATFORM OPERATIONS — Multi-Tenant Monitoring
// NOTE: Full implementation deferred to final phase.
// AuditLog + SystemHealthSnapshot usable now for operational dashboard.
// =======================================================================

model SystemHealthSnapshot {
  id            String   @id @default(uuid())
  tenantId      String
  cpuUsage      Float? // 0-100
  memoryUsedMb  Float?
  memoryTotalMb Float?
  diskUsedMb    Float?
  diskTotalMb   Float?
  uptimeSeconds Int?
  activeUsers   Int?     @default(0)
  apiLatencyMs  Float? // p95 in ms
  errorRate     Float? // percentage
  snapshotAt    DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, snapshotAt(sort: Desc)])
}

model BackupRecord {
  id          String    @id @default(uuid())
  tenantId    String
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  sizeBytes   BigInt?
  status      String    @default("RUNNING") // RUNNING, SUCCESS, FAILED
  location    String? // file path / S3 key
  errorLog    String?
  triggeredBy String? // userId or "SCHEDULED"
  createdAt   DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, startedAt(sort: Desc)])
}

model MaintenanceWindow {
  id          String   @id @default(uuid())
  tenantId    String
  title       String
  description String?
  startsAt    DateTime
  endsAt      DateTime
  status      String   @default("SCHEDULED") // SCHEDULED, ACTIVE, COMPLETED, CANCELLED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, startsAt, endsAt])
}

model LocationPing {
  id             String   @id @default(uuid())
  tenantId       String
  employeeId     String
  recordedAt     DateTime @default(now())
  lat            Float
  lng            Float
  accuracyMeters Float?

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([tenantId, employeeId, recordedAt(sort: Desc)])
  @@index([tenantId, recordedAt(sort: Desc)])
}

model FieldTerritory {
  id              String   @id @default(uuid())
  tenantId        String
  employeeId      String   @unique
  territoryName   String
  boundaryGeoJson String // GeoJSON Polygon/MultiPolygon
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  employee            Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  territoryViolations TerritoryViolation[]

  @@index([tenantId])
}

model LiveTrackingSettings {
  id                  String   @id @default(uuid())
  tenantId            String   @unique
  pingIntervalMinutes Int      @default(15)
  enabled             Boolean  @default(true)
  retentionDays       Int      @default(90)
  requireConsent      Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
}

model TerritoryViolation {
  id             String   @id @default(uuid())
  tenantId       String
  employeeId     String
  territoryId    String
  lat            Float
  lng            Float
  distanceMeters Float
  recordedAt     DateTime @default(now())
  notified       Boolean  @default(false)

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  employee  Employee       @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  territory FieldTerritory @relation(fields: [territoryId], references: [id], onDelete: Restrict)

  @@index([tenantId, employeeId, recordedAt(sort: Desc)])
}

// =======================================================================
// EMPLOYEE ENGAGEMENT SURVEY — v1.0
// =======================================================================

model EngagementSurvey {
  id          String       @id @default(uuid())
  tenantId    String
  title       String
  type        SurveyType   @default(PULSE)
  isAnonymous Boolean      @default(true)
  targetScope String? // JSON: department_ids, grade_ids, etc.
  startDate   DateTime
  endDate     DateTime
  status      SurveyStatus @default(DRAFT)
  createdBy   String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  questions   SurveyQuestion[]
  responses   SurveyResponse[]
  actionItems SurveyActionItem[]

  @@index([tenantId, status])
  @@index([tenantId, startDate, endDate])
}

model SurveyQuestion {
  id           String       @id @default(uuid())
  surveyId     String
  questionText String
  questionType QuestionType
  options      String? // JSON array for multiple choice
  isRequired   Boolean      @default(true)
  order        Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  survey    EngagementSurvey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  responses SurveyResponse[]

  @@index([surveyId, order])
}

model SurveyResponse {
  id           String   @id @default(uuid())
  surveyId     String
  questionId   String
  employeeId   String?
  respondentId String? // Anonymous dedup token — UUID generated per submission (null for identified)
  answerValue  String
  submittedAt  DateTime @default(now())

  survey   EngagementSurvey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  question SurveyQuestion   @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([surveyId, employeeId])
  @@index([surveyId, respondentId])
  @@index([questionId])
}

model SurveyActionItem {
  id          String       @id @default(uuid())
  surveyId    String
  title       String
  description String?
  assigneeId  String
  dueDate     DateTime
  status      ActionStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  survey EngagementSurvey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@index([surveyId, assigneeId])
}

// =======================================================================
// MANPOWER PLANNING — v1.0
// =======================================================================

model ManpowerPlan {
  id           String             @id @default(uuid())
  tenantId     String
  departmentId String
  period       String // e.g., "2026-H1", "2026-Q3"
  version      Int                @default(1)
  status       ManpowerPlanStatus @default(DRAFT)
  submittedBy  String
  approvedBy   String?
  approvedAt   DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  deletedAt    DateTime?

  tenant Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  items  ManpowerPlanItem[]

  @@index([tenantId, departmentId, period])
  @@index([tenantId, status])
}

model ManpowerPlanItem {
  id             String       @id @default(uuid())
  manpowerPlanId String
  positionTitle  String
  gradeId        String?
  quantity       Int          @default(1)
  type           ManpowerType @default(NEW)
  estimatedCost  Float?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  manpowerPlan    ManpowerPlan     @relation(fields: [manpowerPlanId], references: [id], onDelete: Cascade)
  jobRequisitions JobRequisition[]

  @@index([manpowerPlanId])
}

