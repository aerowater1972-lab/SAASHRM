generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =======================================================================
// SYSTEM ADMINISTRATION - Shared Services
// =======================================================================

model Tenant {
  id             String       @id @default(uuid())
  name           String       @unique
  domain         String?      @unique
  package        PackageType  @default(STANDARD)
  status         TenantStatus @default(ACTIVE)
  settings       Json?        @default("{}")
  parentTenantId String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  parentTenant   Tenant?      @relation("TenantHierarchy", fields: [parentTenantId], references: [id], onDelete: SetNull)
  childTenants   Tenant[]     @relation("TenantHierarchy")
  entities       TenantEntity[]
  users                    User[]
  employees                Employee[]
  roles                    Role[]
  featureFlags             FeatureFlag[]
  workflows                WorkflowDefinition[]
  integrations             Integration[]
  auditLogs                AuditLog[]
  systemHealthSnapshots    SystemHealthSnapshot[]
  backupRecords            BackupRecord[]
  maintenanceWindows       MaintenanceWindow[]
  trainings                Training[]
  courses                  Course[]
  feedback360s             Feedback360[]
  idps                     IndividualDevelopmentPlan[]
  provincialWages          ProvincialMinimumWage[]
  violationCategories      ViolationCategory[]
  disciplinaryCases        DisciplinaryCase[]
  incidentReports          IncidentReport[]
  ppeAssignments           PpeAssignment[]
  tenantBranding           TenantBranding?
  ssoConnection            SsoConnection?
  accountingConnectors       AccountingConnector[]
  governmentReportConfigs  GovernmentReportConfig[]
  locationPings            LocationPing[]
  fieldTerritories         FieldTerritory[]
  liveTrackingSettings     LiveTrackingSettings?
  documents                Document[]
  announcements            Announcement[]
  documentCategories       DocumentCategory[]
  talentPools              TalentPool[]
  successionPlans          SuccessionPlan[]
  territoryViolations      TerritoryViolation[]
  engagementSurveys        EngagementSurvey[]
  manpowerPlans            ManpowerPlan[]
  GrievanceCase            GrievanceCase[]
  BipartiteSession         BipartiteSession[]
  BpjsClaim                BpjsClaim[]
  BpjsKetenagakerjaanClaim BpjsKetenagakerjaanClaim[]
  wfhRequests              WfhRequest[]
  wfhPolicies              WfhPolicy[]
  Alumni                   Alumni[]
  outsourcingVendors         OutsourcingVendor[]
  outsourcingContracts       OutsourcingContract[]
  outsourcedWorkers          OutsourcedWorker[]
  outsourcedAttendances      OutsourcedAttendance[]
  outsourcedCostLogs         OutsourcedCostLog[]
  consentRecords             ConsentRecord[]
  dataSubjectRequests        DataSubjectRequest[]
  dataRetentionPolicies      DataRetentionPolicy[]
  dataProcessingLogs         DataProcessingLog[]
  ShiftGroup                 ShiftGroup[]
  helpdeskTickets            HelpdeskTicket[]
  helpdeskKbArticles         HelpdeskKbArticle[]
  ebupotSubmissions          EbupotSubmission[]
  projects                   Project[]
  tasks                      Task[]
  taskComments               TaskComment[]
  taskDependencies           TaskDependency[]
  forumThreads               ForumThread[]
  forumComments              ForumComment[]
  forumReactions             ForumReaction[]
  forumMentions              ForumMention[]
  forumReports               ForumReport[]
  compSalaryStructures       CompSalaryStructure[]
  compReviewCycles           CompReviewCycle[]
  compAdjustments            CompAdjustment[]
  timesheetEntries           TimesheetEntry[]
}

model TenantEntity {
  id         String    @id @default(uuid())
  tenantId   String
  name       String
  code       String
  parentId   String?
  address    String?
  city       String?
  province   String?
  postalCode String?
  timezone   String    @default("Asia/Jakarta")
  npwp       String? // NPWP badan per entitas (multi-NPWP: tiap PT/Cabang punya NPWP sendiri)
  npwpName   String? // Nama wajib pajak sesuai NPWP
  kppCode    String? // Kode KPP terdaftar
  createdAt  DateTime @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  parent   TenantEntity?  @relation("EntityHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children TenantEntity[] @relation("EntityHierarchy")

  departments      Department[]
  holidayCalendars HolidayCalendar[]
  workLocations    WorkLocation[]

  @@unique([tenantId, code])
}

model User {
  id           String     @id @default(uuid())
  tenantId     String
  email        String
  passwordHash String?
  fullName     String
  phone        String?
  avatar       String?
  locale       String     @default("id")
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  mfaEnabled   Boolean    @default(false)
  mfaSecret    String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  employeeId String?   @unique
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  userRoles                  UserRole[]
  notifications              Notification[]
  auditLogs                  AuditLog[]
  approvedDisciplinaryCases  DisciplinaryCase[]    @relation("approved_disciplinary")
  escalatedDisciplinaryCases DisciplinaryCase[]    @relation("escalated_disciplinary")
  reportedIncidents          IncidentReport[]      @relation("reported_incidents")
  documentsCreated           Document[]
  documentVersionsCreated    DocumentVersion[]
  documentPermissionsCreated DocumentPermission[]
  documentSignatures         DocumentSignature[]
  documentActivities         DocumentActivity[]
  announcementsCreated       Announcement[]
  talentPoolMembershipsAdded TalentPoolMember[]
  successionPlansCreated     SuccessionPlan[]      @relation("succession_creator")
  successionCandidatesAdded  SuccessionCandidate[] @relation("succession_candidate_adder")

  // HR Helpdesk (GAP-02)
  helpdeskTicketsAssigned    HelpdeskTicket[]   @relation("helpdesk_assignee")
  helpdeskComments           HelpdeskComment[]
  helpdeskKbArticlesCreated  HelpdeskKbArticle[]
  // e-Bupot / Coretax (GAP-05)
  ebupotSubmissionsCreated   EbupotSubmission[] @relation("ebupot_creator")
  // Task & Project Management (GAP-02)
  projectsOwned                Project[]           @relation("project_owner")
  tasksReported                Task[]              @relation("task_reporter")
  taskComments                 TaskComment[]
  // Internal Communication Hub / Forum (GAP-03)
  forumThreadsCreated          ForumThread[]
  forumCommentsCreated         ForumComment[]
  forumReactionsGiven          ForumReaction[]
  forumReportsCreated          ForumReport[]        @relation("forum_reporter")
  forumReportsReviewed         ForumReport[]        @relation("forum_reviewer")
  // Compensation Management (GAP-06)
  compReviewCyclesCreated      CompReviewCycle[]    @relation("comp_cycle_creator")
  compReviewCyclesApproved     CompReviewCycle[]    @relation("comp_cycle_approver")
  compAdjustmentsApproved      CompAdjustment[]     @relation("comp_adjustment_approver")

  @@unique([tenantId, email])
}

model RefreshTokenBlacklist {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

// Enterprise SSO (SAML 2.0) connection per tenant. One IdP per tenant.
// The IdP x509 cert is stored as provided by the customer's IdP metadata.
model SsoConnection {
  id              String   @id @default(uuid())
  tenantId        String   @unique
  provider        String   @default("SAML") // SAML | OIDC
  entryPoint      String?  // SAML: IdP SSO URL; OIDC: authorization endpoint
  issuer          String?  // SAML: SP entity ID; OIDC: client ID
  cert            String?  @db.Text // SAML: IdP signing cert; OIDC: unused
  nameIdFormat    String?  @default("urn:oasis:names:tc:SAML:1.1:nameid-format:emailAddress")
  clientSecret    String?  // OIDC: client secret (encrypted at rest)
  tokenEndpoint   String?  // OIDC: token endpoint
  userInfoEndpoint String? // OIDC: userinfo endpoint
  jwksUri         String?  // OIDC: JWKS URI for token validation
  discoveryUrl    String?  // OIDC: discovery endpoint
  scopes          String[] @default(["openid", "email", "profile"]) // OIDC scopes
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Role {
  id          String    @id @default(uuid())
  tenantId    String
  name        String
  description String?
  isSystem    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@unique([tenantId, name])
}

model Permission {
  id          String   @id @default(uuid())
  module      String
  action      String // create, read, update, delete, approve
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@unique([module, action])
}

model RolePermission {
  roleId       String
  permissionId String
  scope        String? @default("ALL") // ALL, OWN, DEPARTMENT

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId   String
  roleId   String
  entityId String? // data scope restriction

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model FeatureFlag {
  id        String   @id @default(uuid())
  tenantId  String
  module    String
  feature   String
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, feature])
}

model Integration {
  id           String            @id @default(uuid())
  tenantId     String
  name         String
  type         String // BPJS, BANK, BIOMETRIC, etc
  credentials  String // encrypted
  status       IntegrationStatus @default(ACTIVE)
  lastSyncAt   DateTime?
  errorMessage String?
  config       Json?             @default("{}")
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
}

// =======================================================================
// ACCOUNTING CONNECTORS (Jurnal, Xero, Accurate)
// =======================================================================

enum AccountingConnectorType {
  JURNAL
  XERO
  ACCURATE
  QUICKBOOKS
  CUSTOM
}

model AccountingConnector {
  id              String                   @id @default(uuid())
  tenantId        String
  name            String
  type            AccountingConnectorType
  status          IntegrationStatus        @default(ACTIVE)
  credentials     String                   // encrypted JSON
  config          Json                     @default("{}")
  lastSyncAt      DateTime?
  lastErrorAt     DateTime?
  errorMessage    String?
  syncPayroll     Boolean                  @default(true)
  syncExpense     Boolean                  @default(false)
  syncAsset       Boolean                  @default(false)
  chartOfAccounts Json?                    // mapped account codes
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  syncLogs        AccountingSyncLog[]

  @@unique([tenantId, name])
}

model AccountingSyncLog {
  id              String              @id @default(uuid())
  connectorId     String
  connector       AccountingConnector @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  syncType        String              // PAYROLL, EXPENSE, ASSET, MANUAL
  status          SyncStatus          @default(PENDING)
  recordsTotal    Int                 @default(0)
  recordsSuccess  Int                 @default(0)
  recordsFailed   Int                 @default(0)
  errorDetails    Json?
  startedAt       DateTime            @default(now())
  completedAt     DateTime?
  payload         Json?
  response        Json?

  @@index([connectorId, startedAt])
}

enum SyncStatus {
  PENDING
  IN_PROGRESS
  SUCCESS
  PARTIAL
  FAILED
}

// =======================================================================
// GOVERNMENT REPORTING (DJP Online, BPJS, SIPP)
// =======================================================================

enum GovernmentReportType {
  DJP_SPT_1721_A1    // Annual tax return for employees
  DJP_SPT_1721_A2    // Annual tax return for non-employees
  DJP_EBUPOT_UNIFIKASI // eBupot Unifikasi (PPh 23/26)
  DJP_SPT_MASA_PPH21 // Monthly PPh 21
  DJP_SPT_MASA_PPH23 // Monthly PPh 23
  DJP_SPT_MASA_PPH26 // Monthly PPh 26
  BPJS_KESEHATAN_IURAN // BPJS Kesehatan iuran report
  BPJS_KETENAGAKERJAAN_IURAN // BPJS Ketenagakerjaan iuran report
  BPJS_KETENAGAKERJAAN_JHT // JHT claim report
  BPJS_KETENAGAKERJAAN_JP  // JP report
  BPJS_KETENAGAKERJAAN_KP  // KP report
  SIPP_LAPORAN_TENAGA_KERJA // SIPP manpower report
  SIPP_LAPORAN_UPAH       // SIPP wage report
  CUSTOM
}

enum GovernmentReportStatus {
  DRAFT
  GENERATED
  VALIDATED
  SUBMITTED
  ACCEPTED
  REJECTED
  ERROR
}

model GovernmentReportConfig {
  id              String                   @id @default(uuid())
  tenantId        String
  reportType      GovernmentReportType
  name            String
  status          IntegrationStatus        @default(ACTIVE)
  credentials     String                   // encrypted JSON
  config          Json                     @default("{}")
  schedule        Json?                    // cron expression, timezone
  lastGeneratedAt DateTime?
  lastSubmittedAt DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  tenant      Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  reports     GovernmentReport[]

  @@unique([tenantId, reportType, name])
}

model GovernmentReport {
  id              String                      @id @default(uuid())
  configId        String
  config          GovernmentReportConfig      @relation(fields: [configId], references: [id], onDelete: Cascade)
  periodStart     DateTime
  periodEnd       DateTime
  status          GovernmentReportStatus      @default(DRAFT)
  filePath        String?
  fileName        String?
  fileSize        Int?
  fileHash        String?
  validationErrors Json?
  submissionToken String?
  submissionRef   String?
  submittedAt     DateTime?
  acceptedAt      DateTime?
  rejectedAt      DateTime?
  errorMessage    String?
  payload         Json?
  response        Json?
  revisionOfId    String? // pembetulan atas laporan ini (null = SPT normal/ke-0)
  revisionOf      GovernmentReport?  @relation("ReportRevision", fields: [revisionOfId], references: [id], onDelete: SetNull)
  revisions       GovernmentReport[] @relation("ReportRevision")
  revisionNo      Int                @default(0) // 0 = normal, 1..n = pembetulan ke-n
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt

  @@index([configId, periodStart, periodEnd])
  @@index([status, createdAt])
}

// =======================================================================
// WORKFLOW ENGINE
// =======================================================================

model WorkflowDefinition {
  id          String         @id @default(uuid())
  tenantId    String
  code        String // LEAVE_APPROVAL, PAYROLL_APPROVAL, etc
  name        String
  description String?
  version     Int            @default(1)
  status      WorkflowStatus @default(ACTIVE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  steps     WorkflowStep[]
  instances WorkflowInstance[]

  @@unique([tenantId, code, version])
}

model WorkflowStep {
  id             String       @id @default(uuid())
  workflowDefId  String
  stepOrder      Int
  name           String
  approverType   ApproverType // DIRECT_MANAGER, ROLE, SPECIFIC_USER
  approverRoleId String?
  approverUserId String?
  condition      Json?        @default("{}")
  timeoutHours   Int?         @default(48)
  escalationStep Int?

  workflowDefinition WorkflowDefinition @relation(fields: [workflowDefId], references: [id], onDelete: Cascade)
}

model WorkflowInstance {
  id            String                 @id @default(uuid())
  tenantId      String
  workflowDefId String
  entityType    String // LEAVE_REQUEST, EXPENSE_CLAIM, etc
  entityId      String
  status        WorkflowInstanceStatus @default(PENDING)
  currentStep   Int                    @default(1)
  initiatedBy   String
  initiatedAt   DateTime               @default(now())
  completedAt   DateTime?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  workflowDefinition WorkflowDefinition @relation(fields: [workflowDefId], references: [id], onDelete: Restrict)
  approvals          WorkflowApproval[]
}

model WorkflowApproval {
  id             String         @id @default(uuid())
  workflowInstId String
  stepOrder      Int
  approverId     String
  status         ApprovalStatus @default(PENDING)
  notes          String?
  actedAt        DateTime?
  createdAt      DateTime       @default(now())

  workflowInstance WorkflowInstance @relation(fields: [workflowInstId], references: [id], onDelete: Cascade)
}

// =======================================================================
// NOTIFICATION
// =======================================================================

model Notification {
  id           String             @id @default(uuid())
  tenantId     String
  userId       String
  channel      String // EMAIL, PUSH, IN_APP, SMS
  templateKey  String
  title        String
  body         String
  payload      Json?
  status       NotificationStatus @default(PENDING)
  readAt       DateTime?
  sentAt       DateTime?
  failedAt     DateTime?
  errorMessage String?
  createdAt    DateTime           @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
}

// =======================================================================
// AUDIT LOG
// =======================================================================

model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String
  module    String
  entity    String
  entityId  String
  action    String // CREATE, UPDATE, DELETE, APPROVE, REJECT
  changedBy String?
  changedAt DateTime @default(now())
  oldValue  Json?
  newValue  Json?
  ipAddress String?
  userAgent String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User?  @relation(fields: [changedBy], references: [id], onDelete: SetNull)

  @@index([tenantId, module, entity, entityId])
  @@index([tenantId, changedAt])
}

// =======================================================================
// EMPLOYEE & ORGANIZATION MANAGEMENT
// =======================================================================

model Employee {
  id                   String         @id @default(uuid())
  tenantId             String
  employeeId           String // configurable format per tenant
  fullName             String
  email                String
  phone                String?
  alternativePhone     String?
  birthDate            DateTime?
  birthPlace           String?
  gender               Gender?
  religion             String?
  maritalStatus        MaritalStatus  @default(SINGLE)
  ptkpCategory         String         @default("TK/0") @map("ptkp_category") // GapFix Epic 3 v1.3: kategori PTKP per karyawan (TK/0..TK/3, K/0..K/3); dipakai TaxService, bukan hardcoded
  unionStatus          UnionStatus    @default(NONE) // Addendum Serikat Pekerja (labor_union flag)
  idCardNumber         String? // NIK (encrypted)
  taxIdNumber          String? // NPWP (encrypted)
  socialSecurityNumber String? // BPJS (encrypted)
  bankName             String? // Bank payroll (BCA/MANDIRI/BRI/...)
  bankAccountNumber    String? // Nomor rekening gaji
  bankAccountName      String? // Nama pemilik rekening
  bloodType            String?
  allergies            String?
  medicalNotes         String? // encrypted
  address              String?
  city                 String?
  province             String?
  postalCode           String?
  emergencyContact     String?
  emergencyPhone       String?
  profilePicture       String?
  status               EmployeeStatus @default(PENDING_ACTIVATION)
  startDate            DateTime?
  endDate              DateTime?
  notes                String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  deletedAt            DateTime?

  tenant                         Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user                           User?
  employments                    Employment[]
  documents                      EmployeeDocument[]
  onboardingTasks                OnboardingTask[]
  attendanceRecords              AttendanceRecord[]
  biometricCredentials           BiometricCredential[]
  rosterEntries                  RosterEntry[]
  overtimeRequests               OvertimeRequest[]
  overtimeRecords                OvertimeRecord[]
  leaveRequests                  LeaveRequest[]
  leaveBalances                  LeaveBalance[]
  payslips                       Payslip[]
  performanceReviews             PerformanceReview[]
  goals                          Goal[]
  goalsApproved                  Goal[]                      @relation("goal_approver")
  expenseClaims                  ExpenseClaim[]
  assetAssignments               AssetAssignment[]
  employeeBenefits               EmployeeBenefit[]
  loans                          Loan[]
  resignationRequests            ResignationRequest[]
  trainingParticipants           TrainingParticipant[]
  certifications                 Certification[]
  applications                   Application[]
  contact                        EmployeeContact?
  medical                        EmployeeMedical?
  attendanceCorrectionsRequested AttendanceCorrection[]      @relation("correction_requester")
  attendanceCorrectionsApproved  AttendanceCorrection[]      @relation("correction_approver")
  calibrationSessionsFacilitated CalibrationSession[]        @relation("calibration_facilitator")
  finalScoresCalibrated          FinalScore[]                @relation("final_score_calibrator")
  payrollAdjustments             PayrollAdjustment[]
  thrRecords                     ThrRecord[]
  annualTaxRecords               AnnualTaxRecord[]
  severanceCases                 SeveranceCase[]
  finalScores                    FinalScore[]
  movementRequests               MovementRequest[]
  essNotifications               EssNotification[]
  essOnboardingProgress          EssOnboardingProgress?
  essPreference                  EssPreference?
  essProfileChangeRequests       EssProfileChangeRequest[]
  salaryComponents               SalaryComponent[]
  payrollRunItems                PayrollRunItem[]
  jobRequisitionsApproved        JobRequisition[]            @relation("requisition_approver")
  disciplinaryCases              DisciplinaryCase[]
  incidentReports                IncidentReport[]
  ppeAssignments                 PpeAssignment[]
  // LMS
  courseTrainees                 CourseTrainee[]
  quizAttempts                   QuizAttempt[]
  // 360° Feedback
  feedback360sAsReviewee         Feedback360[]               @relation("feedback_reviewee")
  feedback360sAsReviewer         Feedback360[]               @relation("feedback_reviewer")
  // IDP
  individualDevelopmentPlans     IndividualDevelopmentPlan[]
  workLocationId                 String?
  workLocation                   WorkLocation?               @relation(fields: [workLocationId], references: [id], onDelete: Restrict)
  isFieldWorker                  Boolean                     @default(false)
  locationPings                  LocationPing[]
  fieldTerritory                 FieldTerritory?
  territoryViolations            TerritoryViolation[]
  talentPoolMemberships          TalentPoolMember[]
  successionPlansIncumbent       SuccessionPlan[]            @relation("succession_incumbent")
  successionCandidates           SuccessionCandidate[]
  GrievanceCase                  GrievanceCase[]
  BpjsClaim                      BpjsClaim[]
  BpjsKetenagakerjaanClaim       BpjsKetenagakerjaanClaim[]
  ClearanceCertificate           ClearanceCertificate[]
  wfhRequests                    WfhRequest[]
  alumni                         Alumni[]
  shiftGroup                     ShiftGroup?                 @relation(fields: [shiftGroupId], references: [id], onDelete: Restrict)
  shiftGroupId                   String?
  helpdeskTickets                HelpdeskTicket[]
  helpdeskComments               HelpdeskComment[]
  ebupotSubmissions              EbupotSubmission[]
  // Task & Project Management (GAP-02)
  projectMemberships           ProjectMember[]
  tasksAssigned                Task[]                 @relation("task_assignee")
  taskComments                 TaskComment[]
  forumMentionsReceived        ForumMention[]
  // Compensation Management (GAP-06)
  compAdjustments              CompAdjustment[]
  // Timesheet (attendance x tasks) — gap parity Talenta
  timesheetEntries             TimesheetEntry[]

  @@unique([tenantId, employeeId])
  @@unique([tenantId, email])
  @@index([tenantId, status])
  @@index([workLocationId])
  @@index([isFieldWorker])
}

model Employment {
  id             String         @id @default(uuid())
  employeeId     String
  positionId     String
  departmentId   String
  gradeId        String?
  shiftGroupId   String?
  entityId       String?
  type           EmploymentType @default(PERMANENT)
  startDate      DateTime
  endDate        DateTime?
  isActive       Boolean        @default(true)
  salary         Decimal?       @db.Decimal(18, 2)
  salaryEnc      String?        @map("salary_enc")
  salaryCurrency String         @default("IDR")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  employee   Employee    @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  position   Position    @relation(fields: [positionId], references: [id], onDelete: Restrict)
  department Department  @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  grade      Grade?      @relation(fields: [gradeId], references: [id], onDelete: Restrict)
  shiftGroup ShiftGroup? @relation(fields: [shiftGroupId], references: [id], onDelete: Restrict)
}

model EmployeeDocument {
  id         String         @id @default(uuid())
  employeeId String
  type       DocumentType // KTP, NPWP, IJAZAH, KONTRAK, etc
  fileName   String
  fileUrl    String
  fileSize   Int?
  mimeType   String?
  version    Int            @default(1)
  status     DocumentStatus @default(ACTIVE)
  expiresAt  DateTime?
  notes      String?
  uploadedAt DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
}

model EmployeeContact {
  id                    String   @id @default(uuid())
  employeeId            String
  phone                 String?
  address               String?
  emergencyContactName  String?
  emergencyContactPhone String?
  updatedAt             DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([employeeId])
}

model EmployeeMedical {
  id         String   @id @default(uuid())
  employeeId String
  bloodType  String?
  allergies  String?
  notes      String?
  updatedAt  DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([employeeId])
}

model Organization {
  id            String    @id @default(uuid())
  tenantId      String
  name          String
  code          String    @unique
  description   String?
  parentId      String?
  level         Int       @default(0)
  headUserId    String?
  effectiveDate DateTime  @default(now())
  status        OrgStatus @default(ACTIVE)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  parent                Organization?     @relation("OrgHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children              Organization[]    @relation("OrgHierarchy")
  departments           Department[]
  movementRequestsAsNew MovementRequest[] @relation("OrgMovementRequests")

  @@index([tenantId])
}

model Department {
  id                 String     @id @default(uuid())
  tenantId           String
  organizationId     String
  entityId           String?
  name               String
  code               String
  headEmployeeId     String?
  parentId           String?
  level              Int        @default(0)
  effectiveDate      DateTime   @default(now())
  status             DeptStatus @default(ACTIVE)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  deletedAt          DateTime?
  cutOffTime         String? // HH:mm format, department-level clock-in cut-off
  cutOffGraceMinutes Int        @default(15) // grace minutes for late clock-in

  organization            Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  entity                  TenantEntity?            @relation(fields: [entityId], references: [id], onDelete: Restrict)
  parent                  Department?              @relation("DeptHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children                Department[]             @relation("DeptHierarchy")
  positions               Position[]
  benefitEligibilityRules BenefitEligibilityRule[]
  calibrationSessions     CalibrationSession[]
  requisitions            JobRequisition[]
  movementRequestsAsNew   MovementRequest[]        @relation("DeptMovementRequests")
  employments             Employment[]
  documents               Document[]
  successionPlans         SuccessionPlan[]
  projects                Project[]
  forumThreads              ForumThread[]

  @@unique([tenantId, code])
}

model Position {
  id           String    @id @default(uuid())
  tenantId     String
  departmentId String
  name         String
  code         String
  gradeId      String?
  description  String?
  isHead       Boolean   @default(false)
  maxHeadCount Int?
  riskLevel    String? // VERY_LOW|LOW|MEDIUM|HIGH|VERY_HIGH — risiko JKK (PP 44/2015)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  department                    Department        @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  grade                         Grade?            @relation(fields: [gradeId], references: [id], onDelete: Restrict)
  employments                   Employment[]
  movementRequestsAsNewPosition MovementRequest[]
  successionPlans               SuccessionPlan[]

  @@unique([tenantId, code])
}

model Grade {
  id                       String    @id @default(uuid())
  tenantId                 String
  name                     String
  code                     String
  level                    Int
  description              String?
  minSalary                Float? // FR-03: salary range lower bound for manpower cost estimation
  maxSalary                Float? // FR-03: salary range upper bound
  maxOvertimeHoursPerMonth Int? // GRANTED: maksimal lembur per bulan per grade
  riskLevel                String? // VERY_LOW|LOW|MEDIUM|HIGH|VERY_HIGH — risiko JKK (PP 44/2015), fallback bila Position kosong
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  deletedAt                DateTime?

  positions               Position[]
  employments             Employment[]
  benefitEligibilityRules BenefitEligibilityRule[]

  @@unique([tenantId, code])
}

// =======================================================================
// ATTENDANCE & LEAVE MANAGEMENT
// =======================================================================

model Shift {
  id                         String      @id @default(uuid())
  tenantId                   String
  name                       String
  code                       String
  startTime                  String // HH:mm
  endTime                    String // HH:mm
  breakStart                 String?
  breakEnd                   String?
  gracePeriodMinutes         Int?        @default(15)
  lateThresholdMinutes       Int?        @default(30)
  earlyLeaveThresholdMinutes Int?        @default(15)
  overtimeBeforeMinutes      Int?        @default(0)
  overtimeAfterMinutes       Int?        @default(0)
  color                      String?     @default("#3B82F6")
  isNightShift               Boolean     @default(false)
  status                     ShiftStatus @default(ACTIVE)
  createdAt                  DateTime    @default(now())
  updatedAt                  DateTime    @updatedAt
  deletedAt                  DateTime?

  shiftGroupId  String?
  shiftGroup    ShiftGroup?   @relation(fields: [shiftGroupId], references: [id], onDelete: Restrict)
  rosterEntries RosterEntry[]

  @@index([tenantId, shiftGroupId])
}

model ShiftGroup {
  id          String    @id @default(uuid())
  tenantId    String
  name        String
  code        String
  description String?
  order       Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  shifts     Shift[]
  Employee   Employee[]
  Employment Employment[]

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
}

model Roster {
  id              String       @id @default(uuid())
  tenantId        String
  name            String
  description     String?
  startDate       DateTime
  endDate         DateTime
  rotationPattern Json? // [{day: 0, shiftId: "..."}]
  status          RosterStatus @default(ACTIVE)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  deletedAt       DateTime?

  entries RosterEntry[]
}

model RosterEntry {
  id         String            @id @default(uuid())
  rosterId   String
  employeeId String
  shiftId    String
  date       DateTime
  status     RosterEntryStatus @default(SCHEDULED)

  roster   Roster   @relation(fields: [rosterId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  shift    Shift    @relation(fields: [shiftId], references: [id], onDelete: Restrict)

  @@unique([employeeId, date])
}

model HolidayCalendar {
  id          String      @id @default(uuid())
  tenantId    String
  entityId    String?
  name        String
  date        DateTime
  type        HolidayType @default(NATIONAL)
  isRecurring Boolean     @default(false)
  description String?
  createdAt   DateTime    @default(now())

  entity TenantEntity? @relation(fields: [entityId], references: [id], onDelete: Restrict)

  @@unique([tenantId, date, entityId])
}

model AttendanceRecord {
  id                String           @id @default(uuid())
  tenantId          String
  employeeId        String
  date              DateTime
  clockIn           DateTime?
  clockOut          DateTime?
  clockInMethod     String? // GPS, QR, FACE, FINGERPRINT, MANUAL
  clockOutMethod    String?
  clockInLat        Decimal?         @db.Decimal(10, 8)
  clockInLng        Decimal?         @db.Decimal(11, 8)
  clockInAccuracy   Float? // GPS accuracy in meters reported by the client
  clockInClientTs   DateTime? // client-side capture timestamp (spoof/time-travel detection)
  clockOutLat       Decimal?         @db.Decimal(10, 8)
  clockOutLng       Decimal?         @db.Decimal(11, 8)
  clockOutAccuracy  Float?
  clockOutClientTs  DateTime?
  clockInPhoto      String?
  clockOutPhoto     String?
  clockInFlags      String[]         @default([]) // anti-spoof suspicion reasons at clock-in
  clockOutFlags     String[]         @default([]) // anti-spoof suspicion reasons at clock-out
  isSuspicious      Boolean          @default(false) // true when any anti-spoof flag is present
  spoofReviewedBy   String? // HR user who reviewed the suspicious record
  spoofReviewedAt   DateTime?
  spoofReviewNote   String?
  shiftId           String?
  status            AttendanceStatus @default(PRESENT)
  lateMinutes       Int?
  earlyLeaveMinutes Int?
  overtimeMinutes   Int?
  notes             String?
  isApproved        Boolean          @default(false)
  approvedBy        String?
  approvedAt        DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  employee    Employee               @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  corrections AttendanceCorrection[]

  @@unique([employeeId, date])
  @@index([tenantId, date, status])
}

// Biometric enrollment for fingerprint (from attendance machines) and face (on-prem embedding).
// `reference` stores the fingerprint template (device format) or the face embedding vector (JSON).
model BiometricCredential {
  id         String   @id @default(uuid())
  tenantId   String
  employeeId String
  type       String // FINGERPRINT | FACE
  reference  String // fingerprint template OR face embedding (JSON array of floats)
  deviceId   String? // originating attendance machine id
  isActive   Boolean  @default(true)
  enrolledAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([tenantId, employeeId, type])
  @@index([tenantId, employeeId])
}

model AttendanceCorrection {
  id               String        @id @default(uuid())
  attendanceId     String
  requestedBy      String
  reason           String
  proposedClockIn  DateTime?
  proposedClockOut DateTime?
  status           RequestStatus @default(PENDING)
  approvedBy       String?
  createdAt        DateTime      @default(now())

  attendance AttendanceRecord @relation(fields: [attendanceId], references: [id], onDelete: Restrict)
  requester  Employee         @relation("correction_requester", fields: [requestedBy], references: [id], onDelete: Restrict)
  approver   Employee?        @relation("correction_approver", fields: [approvedBy], references: [id], onDelete: Restrict)

  @@index([attendanceId])
}

model WorkLocation {
  id           String       @id @default(uuid())
  tenantId     String
  name         String
  latitude     Decimal      @db.Decimal(10, 8)
  longitude    Decimal      @db.Decimal(11, 8)
  radiusMeters Int          @default(100)
  isFlexible   Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  employees    Employee[]
  tenant       TenantEntity @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
}

enum WfhRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model WfhRequest {
  id             String           @id @default(uuid())
  tenantId       String
  employeeId     String
  startDate      DateTime
  endDate        DateTime
  reason         String
  status         WfhRequestStatus @default(PENDING)
  approvedBy     String?
  approvedAt     DateTime?
  rejectedReason String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([tenantId, employeeId])
  @@index([tenantId, status])
  @@index([tenantId, startDate])
}

model WfhPolicy {
  id               String    @id @default(uuid())
  tenantId         String
  name             String
  description      String?
  maxDaysPerWeek   Int       @default(2)
  requiresApproval Boolean   @default(true)
  eligibleGrades   String[] // grade IDs yang eligible
  startDate        DateTime
  endDate          DateTime?
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, isActive])
}

model OvertimeRequest {
  id             String        @id @default(uuid())
  tenantId       String
  employeeId     String
  date           DateTime
  startTime      DateTime
  endTime        DateTime
  totalMinutes   Int
  reason         String
  status         RequestStatus @default(PENDING)
  approvedBy     String?
  approvedAt     DateTime?
  notes          String?
  rejectedReason String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  employee Employee         @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  records  OvertimeRecord[]

  @@index([tenantId])
  @@index([employeeId])
}

model OvertimeRecord {
  id                String          @id @default(uuid())
  tenantId          String
  employeeId        String
  overtimeRequestId String?
  date              DateTime
  plannedMinutes    Int
  actualMinutes     Int
  payableMinutes    Int
  dayType           OvertimeDayType @default(HARI_KERJA)
  isRetroactive     Boolean         @default(false)
  isPaid            Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  employee        Employee         @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  overtimeRequest OvertimeRequest? @relation(fields: [overtimeRequestId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([employeeId])
  @@index([overtimeRequestId])
}

model LeaveType {
  id                   String   @id @default(uuid())
  tenantId             String
  name                 String
  code                 String
  description          String?
  isPaid               Boolean  @default(true)
  allowNegativeBalance Boolean  @default(false)
  maxNegativeDays      Decimal? @db.Decimal(5, 2) // hutang cuti: cap saldo negatif (null = tanpa batas)
  maxConsecutiveDays   Int?
  requiresDocument     Boolean  @default(false)
  carryForwardLimit    Int?     @default(0)
  carryForwardExpiry   String? // e.g. "Q1_NEXT_YEAR"
  genderRestriction    Gender?
  minServiceMonths     Int?
  isBalanceDeducting   Boolean  @default(true) // Addendum v1.2: CUTI (true) vs IZIN (false)
  sameDayApproval      Boolean  @default(false) // Addendum v1.2 FR-19: Cuti Haid dapat diajukan hari-H tanpa pre-approval
  isUnionActivity      Boolean  @default(false) // Addendum Serikat Pekerja: izin kegiatan serikat (BR-01: officer only)
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  leaveRequests LeaveRequest[]
  leaveBalances LeaveBalance[]
}

model LeaveBalance {
  id            String   @id @default(uuid())
  tenantId      String
  employeeId    String
  leaveTypeId   String
  year          Int
  totalEntitled Decimal  @db.Decimal(5, 2)
  totalUsed     Decimal  @default(0) @db.Decimal(5, 2)
  totalPending  Decimal  @default(0) @db.Decimal(5, 2)
  carryForward  Decimal  @default(0) @db.Decimal(5, 2)
  debtCarry     Decimal  @default(0) @db.Decimal(5, 2) // hutang cuti dilunasi dari tahun lalu
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)

  @@unique([employeeId, leaveTypeId, year])
}

model LeaveRequest {
  id             String        @id @default(uuid())
  tenantId       String
  employeeId     String
  leaveTypeId    String
  startDate      DateTime
  endDate        DateTime
  totalDays      Decimal       @db.Decimal(5, 2)
  reason         String
  documentUrl    String?
  status         RequestStatus @default(PENDING)
  approvedBy     String?
  approvedAt     DateTime?
  rejectedReason String?
  isUrgent       Boolean       @default(false)
  escalated      Boolean       @default(false)
  eventRef       String?       @map("event_ref") // Addendum v1.2 BR-13: referensi kejadian unik (mis. nama keluarga) untuk izin sekali-pakai per kejadian
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)

  @@index([tenantId, status])
  @@index([employeeId, startDate])
}

// =======================================================================
// PAYROLL, BPJS & PPH21 MANAGEMENT
// =======================================================================

model PayrollComponent {
  id                String                   @id @default(uuid())
  tenantId          String
  name              String
  code              String
  type              PayrollComponentType // ALLOWANCE, DEDUCTION, BPJS_KES, BPJS_KET, PPH21
  category          PayrollComponentCategory @default(FIXED)
  description       String?
  formula           String? // calculation formula (used when calculationMethod = FORMULA)
  calculationMethod String?                  @map("calculation_method") // FIXED | PERCENTAGE | FORMULA (mirrors API DTO)
  defaultValue      Decimal?                 @map("default_value") @db.Decimal(18, 2) // used when calculationMethod = FIXED
  percentage        Decimal?                 @db.Decimal(5, 2) // used when calculationMethod = PERCENTAGE
  maxCap            Decimal?                 @map("max_cap") @db.Decimal(18, 2)
  sortOrder         Int?                     @map("sort_order")
  isTaxable         Boolean                  @default(true)
  isProrated        Boolean                  @default(false)
  value             Decimal?                 @db.Decimal(18, 2)
  isActive          Boolean                  @default(true)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  deletedAt         DateTime?

  payrollItems              PayrollItem[]
  employeeBenefitComponents EmployeeBenefitComponent[]
}

model PayrollAdjustment {
  id            String                  @id @default(uuid())
  tenantId      String
  employeeId    String
  sourceEvent   String // canonical event name that produced this adjustment
  referenceId   String? // claimId / loanId / benefitTypeId / reviewCycleId / grade ids
  type          PayrollAdjustmentType // EARNING, DEDUCTION, SALARY_UPDATE
  amount        Decimal?                @db.Decimal(18, 2)
  currency      String                  @default("IDR")
  description   String?
  effectiveDate DateTime                @default(now())
  expiresAt     DateTime?
  appliedRunId  String? // set when consumed by a payroll run
  status        PayrollAdjustmentStatus @default(PENDING) // PENDING, APPLIED, CANCELLED
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([tenantId, employeeId])
  @@index([tenantId, status])
}

model PayrollPeriod {
  id        String              @id @default(uuid())
  tenantId  String
  name      String
  startDate DateTime
  endDate   DateTime
  status    PayrollPeriodStatus @default(OPEN)
  closedBy  String?
  closedAt  DateTime?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  payrollRuns PayrollRun[]
}

model PayrollRun {
  id             String           @id @default(uuid())
  tenantId       String
  periodId       String
  name           String
  status         PayrollRunStatus @default(DRAFT)
  totalEmployees Int              @default(0)
  totalAmount    Decimal          @default(0) @db.Decimal(20, 2)
  approvedBy     String?
  approvedAt     DateTime?
  processedAt    DateTime?
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  period        PayrollPeriod       @relation(fields: [periodId], references: [id], onDelete: Restrict)
  payslips      Payslip[]
  items         PayrollRunItem[]
  bankTransfers BankTransferBatch[]
}

model PayrollItem {
  id               String   @id @default(uuid())
  payslipId        String
  componentId      String
  amount           Decimal  @db.Decimal(18, 2)
  calculationBasis String?
  description      String?
  createdAt        DateTime @default(now())

  payslip   Payslip          @relation(fields: [payslipId], references: [id], onDelete: Cascade)
  component PayrollComponent @relation(fields: [componentId], references: [id], onDelete: Restrict)
}

model Payslip {
  id               String        @id @default(uuid())
  tenantId         String
  runId            String
  employeeId       String
  baseSalary       Decimal       @db.Decimal(18, 2)
  grossPay         Decimal       @db.Decimal(18, 2)
  totalDeductions  Decimal       @db.Decimal(18, 2)
  netPay           Decimal       @db.Decimal(18, 2)
  bankTransferCode String?
  status           PayslipStatus @default(DRAFT)
  employeeNotes    String?
  emailedAt        DateTime? // kapan slip dikirim via email
  emailTo          String? // alamat tujuan (audit)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  run      PayrollRun    @relation(fields: [runId], references: [id], onDelete: Restrict)
  employee Employee      @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  items    PayrollItem[]

  @@index([tenantId, runId])
}

model SalaryComponent {
  id            String    @id @default(uuid())
  employeeId    String
  componentType String // basic_salary, allowance, deduction
  amount        Decimal   @db.Decimal(18, 2)
  effectiveDate DateTime
  endDate       DateTime?
  createdAt     DateTime  @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([employeeId])
}

model PayrollRunItem {
  id           String   @id @default(uuid())
  payrollRunId String
  employeeId   String
  grossSalary  Decimal  @default(0) @db.Decimal(18, 2)
  netSalary    Decimal  @default(0) @db.Decimal(18, 2)
  status       String   @default("calculated") // calculated, exception
  createdAt    DateTime @default(now())

  run        PayrollRun                @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee   Employee                  @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  components PayrollRunItemComponent[]

  @@unique([payrollRunId, employeeId])
  @@index([payrollRunId])
}

model PayrollRunItemComponent {
  id               String  @id @default(uuid())
  payrollRunItemId String
  componentType    String // basic, bpjs_kesehatan, bpjs_tk, pph21, loan_deduction
  amount           Decimal @db.Decimal(18, 2)

  item PayrollRunItem @relation(fields: [payrollRunItemId], references: [id], onDelete: Cascade)

  @@index([payrollRunItemId])
}

model BankTransferBatch {
  id           String   @id @default(uuid())
  payrollRunId String
  bankCode     String
  fileUrl      String
  status       String   @default("generated") // generated, submitted, confirmed, failed
  generatedAt  DateTime @default(now())

  run PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
}

model BpjsConfig {
  id                  String           @id @default(uuid())
  tenantId            String
  type                BpjsType // KES, KET
  kesEmployerRate     Decimal?         @map("kes_employer_rate") @db.Decimal(5, 4) // BPJS Kesehatan perusahaan (4%)
  kesEmployeeRate     Decimal?         @map("kes_employee_rate") @db.Decimal(5, 4) // BPJS Kesehatan karyawan (1%)
  jkmRate             Decimal          @db.Decimal(5, 4) // e.g. 0.003 (0.3%)
  jkkRate             Decimal          @db.Decimal(5, 4) // risk-based
  jhtEmployerRate     Decimal          @db.Decimal(5, 4)
  jhtEmployeeRate     Decimal          @db.Decimal(5, 4)
  pensionEmployerRate Decimal          @db.Decimal(5, 4)
  pensionEmployeeRate Decimal          @db.Decimal(5, 4)
  maxWageLimit        Decimal?         @db.Decimal(18, 2)
  effectiveDate       DateTime
  status              BpjsConfigStatus @default(ACTIVE)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@unique([tenantId, type, effectiveDate])
}

// BPJS Kesehatan Claim (rawat inap/paru): pencatatan klaim BPJS Kesehatan
// untuk keperluan rekonsiliasi dan laporan BPJS.
model BpjsClaim {
  id             String          @id @default(uuid())
  tenantId       String
  employeeId     String
  claimNumber    String // nomor klaim BPJS
  claimType      BpjsClaimType // RAWAT_INAP, RAWAT_JALAN, KUNING, MERAH, dst
  diagnosisCode  String? // kode ICD-10
  diagnosisName  String?
  admissionDate  DateTime?
  dischargeDate  DateTime?
  daysOfCare     Int?
  hospitalCode   String? // kode rumah sakit BPJS
  hospitalName   String?
  claimAmount    Decimal         @db.Decimal(18, 2) // total tagihan
  approvedAmount Decimal?        @db.Decimal(18, 2) // yang disetujui BPJS
  patientShare   Decimal?        @db.Decimal(18, 2) // biaya peserta (jika ada)
  status         BpjsClaimStatus @default(SUBMITTED) // SUBMITTED, PROCESSING, APPROVED, REJECTED, PAID
  submittedAt    DateTime        @default(now())
  processedAt    DateTime?
  paidAt         DateTime?
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([tenantId, employeeId])
  @@index([tenantId, status])
  @@index([tenantId, claimNumber])
}

model BpjsKetenagakerjaanClaim {
  id             String                         @id @default(uuid())
  tenantId       String
  employeeId     String
  claimNumber    String // nomor klaim BPJS TK
  claimType      BpjsKetenagakerjaanClaimType // JKK, JKM, JHT, JP
  diagnosisCode  String? // kode ICD-10
  diagnosisName  String?
  admissionDate  DateTime?
  dischargeDate  DateTime?
  daysOfCare     Int?
  hospitalCode   String? // kode rumah sakit BPJS
  hospitalName   String?
  claimAmount    Decimal                        @db.Decimal(18, 2) // total tagihan
  approvedAmount Decimal?                       @db.Decimal(18, 2) // yang disetujui BPJS TK
  patientShare   Decimal?                       @db.Decimal(18, 2) // biaya peserta (jika ada)
  status         BpjsKetenagakerjaanClaimStatus @default(SUBMITTED)
  submittedAt    DateTime                       @default(now())
  processedAt    DateTime?
  paidAt         DateTime?
  notes          String?
  createdAt      DateTime                       @default(now())
  updatedAt      DateTime                       @updatedAt
  deletedAt      DateTime?

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
