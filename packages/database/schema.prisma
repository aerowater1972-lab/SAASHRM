// =======================================================================
// POSTGRESQL JOB QUEUE (replaces Redis/BullMQ)
// =======================================================================

model JobQueue {
  id          String    @id @default(uuid())
  queue       String // queue name (e.g. "events", "notifications")
  name        String // job name
  payload     Json
  status      JobStatus @default(PENDING)
  priority    Int       @default(0)
  retries     Int       @default(0)
  maxRetries  Int       @default(3)
  scheduledAt DateTime  @default(now())
  processedAt DateTime?
  errorMsg    String?
  createdAt   DateTime  @default(now())

  @@index([queue, status, scheduledAt])
  @@index([queue, createdAt])
}

model EventOutbox {
  id            String    @id @default(uuid())
  eventName     String
  aggregateId   String
  aggregateType String
  payload       Json
  tenantId      String?
  userId        String?
  status        String    @default("pending") // pending, relayed, failed
  retries       Int       @default(0)
  errorMsg      String?
  createdAt     DateTime  @default(now())
  relayedAt     DateTime?

  @@index([status, createdAt])
  @@index([status, retries])
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

