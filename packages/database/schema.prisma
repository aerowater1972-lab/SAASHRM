  approver   Employee?        @relation("correction_approver", fields: [approvedBy], references: [id], onDelete: Restrict)

  @@index([attendanceId])
}

model WorkLocation {
  id           String       @id @default(uuid())
  tenantId     String
  name         String
  latitude     Decimal      @db.Decimal(10, 8)
  longitude    Decimal      @db.Decimal(11, 8)
  radiusMeters Int          @default(100)
