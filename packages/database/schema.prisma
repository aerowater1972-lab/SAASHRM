  @@index([tenantId, status])
  @@index([tenantId, claimNumber])
}

enum BpjsKetenagakerjaanClaimType {
  JKK
  JKM
  JHT
  JP
}

enum BpjsKetenagakerjaanClaimStatus {
  SUBMITTED
  PROCESSING
  APPROVED
  REJECTED
  PAID
}

enum BpjsClaimType {
  RAWAT_INAP
  RAWAT_JALAN
  KUNING
  MERAH
  KELAHIRAN
  LAINNYA
}

enum BpjsClaimStatus {
  SUBMITTED
  PROCESSING
  APPROVED
  REJECTED
  PAID
}

model TaxConfig {
  id            String          @id @default(uuid())
  tenantId      String
  taxMethod     String // TER, PROGRESSIVE, GROSS_UP
  ptkp          Decimal         @db.Decimal(18, 2) // PTKP amount
  terCategory   String? // A, B, C for TER method
  effectiveDate DateTime
  status        TaxConfigStatus @default(ACTIVE)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([tenantId, taxMethod, effectiveDate])
}

// Rekonsiliasi PPh21 tahunan + bukti potong 1721-A1.
// monthly: gema 12 entri {month, gross, bpjsEmployee, otherDeductions, terWithheld}.
// adjustment = annualTax - totalWithheld (negatif = lebih bayar, dikompensasi).
model AnnualTaxRecord {
  id              String    @id @default(uuid())
  tenantId        String
  employeeId      String
  year            Int
  grossAnnual     Decimal   @db.Decimal(18, 2)
  biayaJabatan    Decimal   @db.Decimal(18, 2)
  bpjsAnnual      Decimal   @db.Decimal(18, 2)
  otherDeductions Decimal   @default(0) @db.Decimal(18, 2)
  netAnnual       Decimal   @db.Decimal(18, 2)
  ptkpCategory    String
  ptkp            Decimal   @db.Decimal(18, 2)
  pkp             Decimal   @db.Decimal(18, 2)
  annualTax       Decimal   @db.Decimal(18, 2)
  totalWithheld   Decimal   @db.Decimal(18, 2)
  adjustment      Decimal   @db.Decimal(18, 2)
  status          String    @default("DRAFT") // DRAFT | FINAL
  finalizedBy     String?
  finalizedAt     DateTime?
  monthly         Json
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([tenantId, employeeId, year])
  @@index([tenantId, year])
}

// THR Keagamaan (Permenaker 6/2016): 1 bulan upah bila masa kerja >= 12
// bulan dalam 12 bulan sebelum hari raya, proporsional bila kurang,
// minimum 1 bulan masa kerja. Upah = gaji pokok + tunjangan tetap.
model ThrRun {
  id          String       @id @default(uuid())
  tenantId    String
  name        String
  holidayName String
  holidayDate DateTime
  dueDate     DateTime // H-7 hari raya
  status      ThrRunStatus @default(DRAFT)
  createdBy   String?
  approvedBy  String?
  approvedAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  records ThrRecord[]

  @@index([tenantId, holidayDate])
}

model ThrRecord {
  id           String    @id @default(uuid())
  runId        String
  employeeId   String
  monthsWorked Int // 1..12 (0 = tidak eligible, tidak dibuat)
  wageBase     Decimal   @db.Decimal(18, 2)
  amount       Decimal   @db.Decimal(18, 2)
  status       String    @default("calculated") // calculated | approved | paid
  paidAt       DateTime?
  createdAt    DateTime  @default(now())

  run      ThrRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([runId, employeeId])
  @@index([employeeId])
}

enum ThrRunStatus {
  DRAFT
  APPROVED
  PAID
  CANCELLED
}

// Pesangon & kompensasi akhir hubungan kerja (PP 35/2021):
// UP = Uang Pesangon (masa kerja), UPMK = penghargaan masa kerja,
// UPH = penggantian hak 15% x (UP+UPMK). Pengali per sebab PHK mengikuti
// matriks PP 35/2021 (lihat komentar di SeveranceService — wajib review
// biro hukum sebelum dipakai untuk kasus sengketa).
// CONTRACT_END = kompensasi PKWT (1 bln upah per 12 bln, proporsional).
model SeveranceCase {
  id              String    @id @default(uuid())
  tenantId        String
  employeeId      String
  cause           String // RESIGNATION | TERMINATION | EFFICIENCY | RETIREMENT | DEATH | MISCONDUCT | ILLNESS | CONTRACT_END
  terminationDate DateTime  @map("termination_date") @db.Date
  tenureMonths    Int       @map("tenure_months")
  wageBase        Decimal   @db.Decimal(18, 2)
  upAmount        Decimal   @default(0) @map("up_amount") @db.Decimal(18, 2)
  upmkAmount      Decimal   @default(0) @map("upmk_amount") @db.Decimal(18, 2)
  uphAmount       Decimal   @default(0) @map("uph_amount") @db.Decimal(18, 2)
  pisahAmount     Decimal   @default(0) @map("pisah_amount") @db.Decimal(18, 2)
  totalAmount     Decimal   @db.Decimal(18, 2)
  status          String    @default("DRAFT") // DRAFT | APPROVED | PAID | CANCELLED
  decidedBy       String?   @map("decided_by")
  decidedAt       DateTime? @map("decided_at")
  paidAt          DateTime? @map("paid_at")
  notes           String?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([tenantId, status])
  @@index([employeeId])
}

// =======================================================================
// RECRUITMENT & ONBOARDING
// =======================================================================

model JobRequisition {
  id                 String   @id @default(uuid())
  tenantId           String
  title              String
  departmentId       String
  status             String   @default("pending_approval") // pending_approval, approved, rejected, closed
  approvedBy         String?
  manpowerPlanItemId String? // Link to approved manpower plan item (FR-04)
  createdAt          DateTime @default(now())

  department       Department        @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  approver         Employee?         @relation("requisition_approver", fields: [approvedBy], references: [id], onDelete: Restrict)
  manpowerPlanItem ManpowerPlanItem? @relation(fields: [manpowerPlanItemId], references: [id], onDelete: Restrict)
  postings         JobPosting[]

  @@index([tenantId, status])
}

model JobPosting {
  id               String        @id @default(uuid())
  tenantId         String
  requisitionId    String?
  positionId       String
  title            String
  description      String
  requirements     String?
  responsibilities String?
  minSalary        Decimal?      @db.Decimal(18, 2)
  maxSalary        Decimal?      @db.Decimal(18, 2)
  employmentType   String? // FULL_TIME, PART_TIME, CONTRACT, INTERNSHIP
  location         String?
  slots            Int           @default(1)
  filledSlots      Int           @default(0)
  status           PostingStatus @default(DRAFT)
  postedAt         DateTime?
  closedAt         DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  applications Application[]
  requisition  JobRequisition? @relation(fields: [requisitionId], references: [id], onDelete: Restrict)
}

model Candidate {
  id              String          @id @default(uuid())
  tenantId        String
  firstName       String
  lastName        String
  email           String
  phone           String?
  resumeUrl       String?
  source          String? // LINKEDIN, JOBBOARD, REFERRAL, DIRECT
  currentCompany  String?
  currentPosition String?
  notes           String?
  status          CandidateStatus @default(ACTIVE)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?

  purgeAfter   DateTime? // retention: when to purge/anonymize PII after rejection
  anonymizedAt DateTime? // set once PII has been anonymized/deleted

  applications Application[]
  referrals    EmployeeReferral[]
}

model EmployeeReferral {
  id                  String        @id @default(uuid())
  tenantId            String
  referrerEmployeeId  String // employee who submitted the referral
  referredCandidateId String? // linked Candidate record created for this referral
  candidateName       String
  candidateEmail      String
  candidatePhone      String?
  resumeUrl           String?
  positionApplied     String?
  notes               String?
  bonusAmount         Decimal?      @db.Decimal(18, 2)
  status              ReferralStatus @default(PENDING)
  bonusPaidAt         DateTime? // set automatically when the referred candidate is hired
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  candidate Candidate? @relation(fields: [referredCandidateId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([tenantId, referrerEmployeeId])
  @@index([tenantId, candidateEmail])
}

model Application {
  id             String            @id @default(uuid())
  tenantId       String
  jobPostingId   String
  candidateId    String
  employeeId     String? // converted from candidate
  status         ApplicationStatus @default(NEW)
  expectedSalary Decimal?          @db.Decimal(18, 2)
  notes          String?
  appliedAt      DateTime          @default(now())
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  jobPosting          JobPosting           @relation(fields: [jobPostingId], references: [id], onDelete: Restrict)
  candidate           Candidate            @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  employee            Employee?            @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  interviews          Interview[]
  offers              Offer[]
  onboardingDocuments OnboardingDocument[]
}

model Interview {
  id              String          @id @default(uuid())
  applicationId   String
  stage           Int             @default(1)
  type            InterviewType // ONLINE, OFFLINE, PHONE
  interviewerId   String
  scheduledAt     DateTime
  durationMinutes Int
  location        String?
  meetingLink     String?
  score           Decimal?        @db.Decimal(5, 2)
  feedback        String?
  status          InterviewStatus @default(SCHEDULED)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  application Application          @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  scorecards  InterviewScorecard[]
}

model InterviewScorecard {
  id          String  @id @default(uuid())
  interviewId String
  competency  String
  score       Int // 1-5
  notes       String?

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@index([interviewId])
}

model Offer {
  id                 String      @id @default(uuid())
  applicationId      String
  version            Int         @default(1)
  baseSalary         Decimal     @db.Decimal(18, 2)
  allowance          Decimal?    @db.Decimal(18, 2)
  benefitDescription String?
  joinDate           DateTime
  status             OfferStatus @default(DRAFT)
  sentAt             DateTime?
  acceptedAt         DateTime?
  rejectedAt         DateTime?
  notes              String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, version])
}

model OnboardingDocument {
  id            String   @id @default(uuid())
  applicationId String
  docType       String
  fileUrl       String
  uploadedAt    DateTime @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

// Onboarding checklist tasks span cross-functional teams (HR, IT, Finance).
// BR-06: a task may only be marked complete by its assigned owner team/employee,
// not unilaterally by HR Admin.
model OnboardingTask {
  id              String               @id @default(uuid())
  tenantId        String
  employeeId      String // the new hire the task belongs to
  applicationId   String?
  title           String
  description     String?
  ownerTeam       OnboardingOwnerTeam // HR, IT, FINANCE
  ownerEmployeeId String? // specific assignee (Employee id); if null, any member of ownerTeam may complete
  status          OnboardingTaskStatus @default(PENDING)
  completedBy     String? // employeeId of the completer (must belong to ownerTeam)
  completedAt     DateTime?
  dueDate         DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId, employeeId])
  @@index([tenantId, status])
}

enum OnboardingOwnerTeam {
  HR
  IT
  FINANCE
}

enum OnboardingTaskStatus {
  PENDING
  DONE
}

// =======================================================================
// ASSET MANAGEMENT
// =======================================================================

model Asset {
  id            String         @id @default(uuid())
  tenantId      String
  name          String
  code          String
  category      AssetCategory // LAPTOP, PHONE, VEHICLE, CARD, OTHER
  brand         String?
  model         String?
  serialNumber  String?
  purchaseDate  DateTime?
  purchasePrice Decimal?       @db.Decimal(18, 2)
  condition     AssetCondition @default(GOOD)
  status        AssetStatus    @default(AVAILABLE)
  notes         String?
  qrToken       String?  // token stabil untuk QR inventaris (URL verifikasi publik; unik ditegakkan di service)
  usefulLifeMonths Int? // masa manfaat (bulan) untuk depresiasi
  residualValue Decimal? @db.Decimal(18, 2) // nilai sisa
  depreciationMethod String @default("STRAIGHT_LINE") // STRAIGHT_LINE | DECLINING_BALANCE
  depreciationStartDate DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  assignments AssetAssignment[]
  depreciations AssetDepreciation[]

  @@unique([tenantId, code])
  @@index([qrToken])
}

// =======================================================================
// BIOMETRIC DEVICES (mesin fingerprint: registry + PIN mapping)
// =======================================================================

model BiometricDevice {
  id          String    @id @default(uuid())
  tenantId    String
  deviceId    String // ID unik mesin (SN / device code)
  name        String
  location    String?
  apiKeyHash  String // sha256(device api key); raw key hanya terlihat saat registrasi
  isActive    Boolean   @default(true)
  lastSeenAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([tenantId, deviceId])
  @@index([tenantId])
}

// =======================================================================
// FLIP DISBURSEMENT (transfer gaji via Flip API; DRY_RUN bila tanpa kredensial)
// =======================================================================

enum FlipDisbursementStatus {
  DRAFT // payload siap, belum dikirim (dry-run)
  PENDING // terkirim, menunggu status final
  SUCCESS
  FAILED
  CANCELLED
}

model FlipDisbursement {
  id             String                 @id @default(uuid())
  tenantId       String
  payrollRunId   String?
  flipId         String? // id dari Flip (bila LIVE)
  idempotencyKey String                 @unique
  bankCode       String // kode bank Flip (lowercase, mis. bca)
  accountNumber  String
  accountName    String
  amount         Decimal                @db.Decimal(18, 2)
  remark         String?
  status         FlipDisbursementStatus @default(DRAFT)
  dryRun         Boolean                @default(true)
  attempts       Int                    @default(0) // jumlah retry (PD-04), max via FLIP_MAX_RETRIES
  rawResponse    Json?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([tenantId, payrollRunId])
  @@index([status])
}

model AssetDepreciation {
  id             String   @id @default(uuid())
  assetId        String
  asset          Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  year           Int
  month          Int // 1-12
  amount         Decimal  @db.Decimal(18, 2)
  bookValueAfter Decimal  @db.Decimal(18, 2)
  createdAt      DateTime @default(now())

  @@unique([assetId, year, month])
  @@index([year, month])
}

model AssetAssignment {
  id                String    @id @default(uuid())
  assetId           String
  employeeId        String
  assignedAt        DateTime  @default(now())
  returnedAt        DateTime?
  conditionOnReturn String?
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  asset    Asset    @relation(fields: [assetId], references: [id], onDelete: Restrict)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
}

// =======================================================================
// EXPENSE CLAIM & LOAN MANAGEMENT
// =======================================================================

model ExpenseClaim {
  id          String        @id @default(uuid())
  tenantId    String
  employeeId  String
  title       String
  description String?
  totalAmount Decimal       @db.Decimal(18, 2)
  currency    String        @default("IDR")
  status      RequestStatus @default(PENDING)
  submittedAt DateTime?
  approvedBy  String?
  approvedAt  DateTime?
  paidAt      DateTime?
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  employee Employee      @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  items    ExpenseItem[]
}

model ExpenseItem {
  id          String          @id @default(uuid())
  claimId     String
  category    ExpenseCategory // TRAVEL, MEAL, ENTERTAINMENT, OFFICE, OTHER
  description String
  amount      Decimal         @db.Decimal(18, 2)
  receiptUrl  String?
  date        DateTime?
  createdAt   DateTime        @default(now())

  claim ExpenseClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
}

// =======================================================================
// VENDOR PPh 23/26 WITHHOLDING (PMK-141/2015, UU PPh 36/2008)
// =======================================================================

enum VendorTaxType {
  NONE
  PPH23_JASA // 2% jasa (PMK-141)
  PPH23_SEWA // 2% sewa selain tanah/bangunan
  PPH23_DIVIDEN // 15% (non-final, WP badan DN)
  PPH23_BUNGA_ROYALTI // 15%
  PPH23_HADIAH // 15%
  PPH26 // 20% atau tarif P3B/treaty
}

enum VendorInvoiceStatus {
  DRAFT
  APPROVED
  PAID
  CANCELLED
}

model Vendor {
  id           String   @id @default(uuid())
  tenantId     String
  name         String
  npwp         String?
  address      String?
  country      String   @default("ID")
  isForeign    Boolean  @default(false)
  treatyRate   Decimal? @db.Decimal(5, 2) // tarif P3B untuk PPh 26, cth 10.00
  bankName     String?
  bankAccount  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  invoices VendorInvoice[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model VendorInvoice {
  id          String              @id @default(uuid())
  tenantId    String
  vendorId    String
  vendor      Vendor              @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  invoiceNo   String
  invoiceDate DateTime
  dueDate     DateTime?
  description String?
  grossAmount Decimal             @db.Decimal(18, 2)
  taxType     VendorTaxType       @default(NONE)
  taxRate     Decimal             @default(0) @db.Decimal(5, 2)
  taxAmount   Decimal             @default(0) @db.Decimal(18, 2)
  netAmount   Decimal             @default(0) @db.Decimal(18, 2)
  grossUp     Boolean             @default(false) // true: PPh ditanggung perusahaan (gross-up)
  status      VendorInvoiceStatus @default(DRAFT)
  paidAt      DateTime?
  ebupotRef   String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([tenantId, invoiceNo])
  @@index([tenantId, status])
}

model Loan {
  id                 String        @id @default(uuid())
  tenantId           String
  employeeId         String
  amount             Decimal       @db.Decimal(18, 2)
  installmentCount   Int
  installmentAmount  Decimal       @db.Decimal(18, 2)
  purpose            String?
  status             RequestStatus @default(PENDING)
  approvedBy         String?
  approvedAt         DateTime?
  startDeductionFrom String? // payroll period
  remainingBalance   Decimal       @db.Decimal(18, 2)
  notes              String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  employee     Employee          @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  installments LoanInstallment[]
}

model LoanInstallment {
  id           String            @id @default(uuid())
  loanId       String
  periodName   String
  amount       Decimal           @db.Decimal(18, 2)
  status       InstallmentStatus @default(PENDING)
  paidAt       DateTime?
  payrollRunId String?
  createdAt    DateTime          @default(now())

  loan Loan @relation(fields: [loanId], references: [id], onDelete: Cascade)
}

// =======================================================================
// BENEFIT MANAGEMENT
