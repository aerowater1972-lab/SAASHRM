// =======================================================================
// PAYROLL, BPJS & PPH21 MANAGEMENT
// =======================================================================

model PayrollComponent {
  id                String                   @id @default(uuid())
  tenantId          String
  name              String
  code              String
  type              PayrollComponentType // ALLOWANCE, DEDUCTION, BPJS_KES, BPJS_KET, PPH21
  category          PayrollComponentCategory @default(FIXED)
  description       String?
  formula           String? // calculation formula (used when calculationMethod = FORMULA)
  calculationMethod String?                  @map("calculation_method") // FIXED | PERCENTAGE | FORMULA (mirrors API DTO)
  defaultValue      Decimal?                 @map("default_value") @db.Decimal(18, 2) // used when calculationMethod = FIXED
  percentage        Decimal?                 @db.Decimal(5, 2) // used when calculationMethod = PERCENTAGE
  maxCap            Decimal?                 @map("max_cap") @db.Decimal(18, 2)
  sortOrder         Int?                     @map("sort_order")
  isTaxable         Boolean                  @default(true)
  isProrated        Boolean                  @default(false)
  value             Decimal?                 @db.Decimal(18, 2)
  isActive          Boolean                  @default(true)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  deletedAt         DateTime?

  payrollItems              PayrollItem[]
  employeeBenefitComponents EmployeeBenefitComponent[]
}

model PayrollAdjustment {
  id            String                  @id @default(uuid())
  tenantId      String
  employeeId    String
  sourceEvent   String // canonical event name that produced this adjustment
  referenceId   String? // claimId / loanId / benefitTypeId / reviewCycleId / grade ids
  type          PayrollAdjustmentType // EARNING, DEDUCTION, SALARY_UPDATE
  amount        Decimal?                @db.Decimal(18, 2)
  currency      String                  @default("IDR")
  description   String?
  effectiveDate DateTime                @default(now())
  expiresAt     DateTime?
  appliedRunId  String? // set when consumed by a payroll run
  status        PayrollAdjustmentStatus @default(PENDING) // PENDING, APPLIED, CANCELLED
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([tenantId, employeeId])
  @@index([tenantId, status])
}

model PayrollPeriod {
  id        String              @id @default(uuid())
  tenantId  String
  name      String
  startDate DateTime
  endDate   DateTime
  status    PayrollPeriodStatus @default(OPEN)
  closedBy  String?
  closedAt  DateTime?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  payrollRuns PayrollRun[]
}

model PayrollRun {
  id             String           @id @default(uuid())
  tenantId       String
  periodId       String
  name           String
  status         PayrollRunStatus @default(DRAFT)
  totalEmployees Int              @default(0)
  totalAmount    Decimal          @default(0) @db.Decimal(20, 2)
  approvedBy     String?
  approvedAt     DateTime?
  processedAt    DateTime?
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  period        PayrollPeriod       @relation(fields: [periodId], references: [id], onDelete: Restrict)
  payslips      Payslip[]
  items         PayrollRunItem[]
  bankTransfers BankTransferBatch[]
}

model PayrollItem {
  id               String   @id @default(uuid())
  payslipId        String
  componentId      String
  amount           Decimal  @db.Decimal(18, 2)
  calculationBasis String?
  description      String?
  createdAt        DateTime @default(now())

  payslip   Payslip          @relation(fields: [payslipId], references: [id], onDelete: Cascade)
  component PayrollComponent @relation(fields: [componentId], references: [id], onDelete: Restrict)
}

model Payslip {
  id               String        @id @default(uuid())
  tenantId         String
  runId            String
  employeeId       String
  baseSalary       Decimal       @db.Decimal(18, 2)
  grossPay         Decimal       @db.Decimal(18, 2)
  totalDeductions  Decimal       @db.Decimal(18, 2)
  netPay           Decimal       @db.Decimal(18, 2)
  bankTransferCode String?
  status           PayslipStatus @default(DRAFT)
  employeeNotes    String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  run      PayrollRun    @relation(fields: [runId], references: [id], onDelete: Restrict)
  employee Employee      @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  items    PayrollItem[]

  @@index([tenantId, runId])
}

model SalaryComponent {
  id            String    @id @default(uuid())
  employeeId    String
  componentType String // basic_salary, allowance, deduction
  amount        Decimal   @db.Decimal(18, 2)
  effectiveDate DateTime
  endDate       DateTime?
  createdAt     DateTime  @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([employeeId])
}

model PayrollRunItem {
  id           String   @id @default(uuid())
  payrollRunId String
  employeeId   String
  grossSalary  Decimal  @default(0) @db.Decimal(18, 2)
  netSalary    Decimal  @default(0) @db.Decimal(18, 2)
  status       String   @default("calculated") // calculated, exception
  createdAt    DateTime @default(now())

  run        PayrollRun                @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee   Employee                  @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  components PayrollRunItemComponent[]

  @@unique([payrollRunId, employeeId])
  @@index([payrollRunId])
}

model PayrollRunItemComponent {
  id               String  @id @default(uuid())
  payrollRunItemId String
  componentType    String // basic, bpjs_kesehatan, bpjs_tk, pph21, loan_deduction
  amount           Decimal @db.Decimal(18, 2)

  item PayrollRunItem @relation(fields: [payrollRunItemId], references: [id], onDelete: Cascade)

  @@index([payrollRunItemId])
}

model BankTransferBatch {
  id           String   @id @default(uuid())
  payrollRunId String
  bankCode     String
  fileUrl      String
  status       String   @default("generated") // generated, submitted, confirmed, failed
  generatedAt  DateTime @default(now())

  run PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
}

model BpjsConfig {
  id                  String           @id @default(uuid())
  tenantId            String
  type                BpjsType // KES, KET
  kesEmployerRate     Decimal?         @map("kes_employer_rate") @db.Decimal(5, 4) // BPJS Kesehatan perusahaan (4%)
  kesEmployeeRate     Decimal?         @map("kes_employee_rate") @db.Decimal(5, 4) // BPJS Kesehatan karyawan (1%)
  jkmRate             Decimal          @db.Decimal(5, 4) // e.g. 0.003 (0.3%)
  jkkRate             Decimal          @db.Decimal(5, 4) // risk-based
  jhtEmployerRate     Decimal          @db.Decimal(5, 4)
  jhtEmployeeRate     Decimal          @db.Decimal(5, 4)
  pensionEmployerRate Decimal          @db.Decimal(5, 4)
  pensionEmployeeRate Decimal          @db.Decimal(5, 4)
  maxWageLimit        Decimal?         @db.Decimal(18, 2)
  effectiveDate       DateTime
  status              BpjsConfigStatus @default(ACTIVE)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@unique([tenantId, type, effectiveDate])
}

// BPJS Kesehatan Claim (rawat inap/paru): pencatatan klaim BPJS Kesehatan
// untuk keperluan rekonsiliasi dan laporan BPJS.
model BpjsClaim {
  id             String          @id @default(uuid())
  tenantId       String
  employeeId     String
  claimNumber    String // nomor klaim BPJS
  claimType      BpjsClaimType // RAWAT_INAP, RAWAT_JALAN, KUNING, MERAH, dst
  diagnosisCode  String? // kode ICD-10
  diagnosisName  String?
  admissionDate  DateTime?
  dischargeDate  DateTime?
  daysOfCare     Int?
  hospitalCode   String? // kode rumah sakit BPJS
  hospitalName   String?
  claimAmount    Decimal         @db.Decimal(18, 2) // total tagihan
  approvedAmount Decimal?        @db.Decimal(18, 2) // yang disetujui BPJS
  patientShare   Decimal?        @db.Decimal(18, 2) // biaya peserta (jika ada)
  status         BpjsClaimStatus @default(SUBMITTED) // SUBMITTED, PROCESSING, APPROVED, REJECTED, PAID
  submittedAt    DateTime        @default(now())
  processedAt    DateTime?
  paidAt         DateTime?
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([tenantId, employeeId])
  @@index([tenantId, status])
  @@index([tenantId, claimNumber])
}

model BpjsKetenagakerjaanClaim {
  id             String                         @id @default(uuid())
  tenantId       String
  employeeId     String
  claimNumber    String // nomor klaim BPJS TK
  claimType      BpjsKetenagakerjaanClaimType // JKK, JKM, JHT, JP
  diagnosisCode  String? // kode ICD-10
  diagnosisName  String?
  admissionDate  DateTime?
  dischargeDate  DateTime?
  daysOfCare     Int?
  hospitalCode   String? // kode rumah sakit BPJS
  hospitalName   String?
  claimAmount    Decimal                        @db.Decimal(18, 2) // total tagihan
  approvedAmount Decimal?                       @db.Decimal(18, 2) // yang disetujui BPJS TK
  patientShare   Decimal?                       @db.Decimal(18, 2) // biaya peserta (jika ada)
  status         BpjsKetenagakerjaanClaimStatus @default(SUBMITTED)
  submittedAt    DateTime                       @default(now())
  processedAt    DateTime?
  paidAt         DateTime?
  notes          String?
  createdAt      DateTime                       @default(now())
  updatedAt      DateTime                       @updatedAt
  deletedAt      DateTime?

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([tenantId, employeeId])
  @@index([tenantId, status])
  @@index([tenantId, claimNumber])
}

enum BpjsKetenagakerjaanClaimType {
  JKK
  JKM
  JHT
  JP
}

enum BpjsKetenagakerjaanClaimStatus {
  SUBMITTED
  PROCESSING
  APPROVED
  REJECTED
  PAID
}

enum BpjsClaimType {
  RAWAT_INAP
  RAWAT_JALAN
  KUNING
  MERAH
  KELAHIRAN
  LAINNYA
}

enum BpjsClaimStatus {
  SUBMITTED
  PROCESSING
  APPROVED
  REJECTED
  PAID
}

model TaxConfig {
  id            String          @id @default(uuid())
  tenantId      String
  taxMethod     String // TER, PROGRESSIVE, GROSS_UP
  ptkp          Decimal         @db.Decimal(18, 2) // PTKP amount
  terCategory   String? // A, B, C for TER method
  effectiveDate DateTime
  status        TaxConfigStatus @default(ACTIVE)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([tenantId, taxMethod, effectiveDate])
}

// Rekonsiliasi PPh21 tahunan + bukti potong 1721-A1.
// monthly: gema 12 entri {month, gross, bpjsEmployee, otherDeductions, terWithheld}.
// adjustment = annualTax - totalWithheld (negatif = lebih bayar, dikompensasi).
model AnnualTaxRecord {
  id              String    @id @default(uuid())
  tenantId        String
  employeeId      String
  year            Int
  grossAnnual     Decimal   @db.Decimal(18, 2)
  biayaJabatan    Decimal   @db.Decimal(18, 2)
  bpjsAnnual      Decimal   @db.Decimal(18, 2)
  otherDeductions Decimal   @default(0) @db.Decimal(18, 2)
  netAnnual       Decimal   @db.Decimal(18, 2)
  ptkpCategory    String
  ptkp            Decimal   @db.Decimal(18, 2)
  pkp             Decimal   @db.Decimal(18, 2)
  annualTax       Decimal   @db.Decimal(18, 2)
  totalWithheld   Decimal   @db.Decimal(18, 2)
  adjustment      Decimal   @db.Decimal(18, 2)
  status          String    @default("DRAFT") // DRAFT | FINAL
  finalizedBy     String?
  finalizedAt     DateTime?
  monthly         Json
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([tenantId, employeeId, year])
  @@index([tenantId, year])
}

// THR Keagamaan (Permenaker 6/2016): 1 bulan upah bila masa kerja >= 12
// bulan dalam 12 bulan sebelum hari raya, proporsional bila kurang,
// minimum 1 bulan masa kerja. Upah = gaji pokok + tunjangan tetap.
model ThrRun {
  id          String       @id @default(uuid())
  tenantId    String
  name        String
  holidayName String
  holidayDate DateTime
  dueDate     DateTime // H-7 hari raya
  status      ThrRunStatus @default(DRAFT)
  createdBy   String?
  approvedBy  String?
  approvedAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  records ThrRecord[]

  @@index([tenantId, holidayDate])
}

model ThrRecord {
  id           String    @id @default(uuid())
  runId        String
  employeeId   String
  monthsWorked Int // 1..12 (0 = tidak eligible, tidak dibuat)
  wageBase     Decimal   @db.Decimal(18, 2)
  amount       Decimal   @db.Decimal(18, 2)
  status       String    @default("calculated") // calculated | approved | paid
  paidAt       DateTime?
  createdAt    DateTime  @default(now())

  run      ThrRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([runId, employeeId])
  @@index([employeeId])
}

enum ThrRunStatus {
  DRAFT
  APPROVED
  PAID
  CANCELLED
}

// Pesangon & kompensasi akhir hubungan kerja (PP 35/2021):
// UP = Uang Pesangon (masa kerja), UPMK = penghargaan masa kerja,
// UPH = penggantian hak 15% x (UP+UPMK). Pengali per sebab PHK mengikuti
// matriks PP 35/2021 (lihat komentar di SeveranceService — wajib review
// biro hukum sebelum dipakai untuk kasus sengketa).
// CONTRACT_END = kompensasi PKWT (1 bln upah per 12 bln, proporsional).
model SeveranceCase {
  id              String    @id @default(uuid())
  tenantId        String
  employeeId      String
  cause           String // RESIGNATION | TERMINATION | EFFICIENCY | RETIREMENT | DEATH | MISCONDUCT | ILLNESS | CONTRACT_END
  terminationDate DateTime  @map("termination_date") @db.Date
  tenureMonths    Int       @map("tenure_months")
  wageBase        Decimal   @db.Decimal(18, 2)
  upAmount        Decimal   @default(0) @map("up_amount") @db.Decimal(18, 2)
  upmkAmount      Decimal   @default(0) @map("upmk_amount") @db.Decimal(18, 2)
  uphAmount       Decimal   @default(0) @map("uph_amount") @db.Decimal(18, 2)
  pisahAmount     Decimal   @default(0) @map("pisah_amount") @db.Decimal(18, 2)
  totalAmount     Decimal   @db.Decimal(18, 2)
  status          String    @default("DRAFT") // DRAFT | APPROVED | PAID | CANCELLED
  decidedBy       String?   @map("decided_by")
  decidedAt       DateTime? @map("decided_at")
  paidAt          DateTime? @map("paid_at")
  notes           String?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([tenantId, status])
  @@index([employeeId])
}

// =======================================================================
// RECRUITMENT & ONBOARDING
// =======================================================================

model JobRequisition {
  id                 String   @id @default(uuid())
  tenantId           String
  title              String
  departmentId       String
  status             String   @default("pending_approval") // pending_approval, approved, rejected, closed
  approvedBy         String?
  manpowerPlanItemId String? // Link to approved manpower plan item (FR-04)
  createdAt          DateTime @default(now())

  department       Department        @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  approver         Employee?         @relation("requisition_approver", fields: [approvedBy], references: [id], onDelete: Restrict)
  manpowerPlanItem ManpowerPlanItem? @relation(fields: [manpowerPlanItemId], references: [id], onDelete: Restrict)
  postings         JobPosting[]

  @@index([tenantId, status])
}

model JobPosting {
  id               String        @id @default(uuid())
  tenantId         String
  requisitionId    String?
  positionId       String
  title            String
  description      String
  requirements     String?
  responsibilities String?
  minSalary        Decimal?      @db.Decimal(18, 2)
  maxSalary        Decimal?      @db.Decimal(18, 2)
  employmentType   String? // FULL_TIME, PART_TIME, CONTRACT, INTERNSHIP
  location         String?
  slots            Int           @default(1)
  filledSlots      Int           @default(0)
  status           PostingStatus @default(DRAFT)
  postedAt         DateTime?
  closedAt         DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  applications Application[]
  requisition  JobRequisition? @relation(fields: [requisitionId], references: [id], onDelete: Restrict)
}

model Candidate {
  id              String          @id @default(uuid())
  tenantId        String
  firstName       String
  lastName        String
  email           String
  phone           String?
  resumeUrl       String?
  source          String? // LINKEDIN, JOBBOARD, REFERRAL, DIRECT
  currentCompany  String?
  currentPosition String?
  notes           String?
  status          CandidateStatus @default(ACTIVE)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?

  purgeAfter   DateTime? // retention: when to purge/anonymize PII after rejection
  anonymizedAt DateTime? // set once PII has been anonymized/deleted

  applications Application[]
}

model Application {
  id             String            @id @default(uuid())
  tenantId       String
  jobPostingId   String
  candidateId    String
  employeeId     String? // converted from candidate
  status         ApplicationStatus @default(NEW)
  expectedSalary Decimal?          @db.Decimal(18, 2)
  notes          String?
  appliedAt      DateTime          @default(now())
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  jobPosting          JobPosting           @relation(fields: [jobPostingId], references: [id], onDelete: Restrict)
  candidate           Candidate            @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  employee            Employee?            @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  interviews          Interview[]
  offers              Offer[]
  onboardingDocuments OnboardingDocument[]
}

model Interview {
  id              String          @id @default(uuid())
  applicationId   String
  stage           Int             @default(1)
  type            InterviewType // ONLINE, OFFLINE, PHONE
  interviewerId   String
  scheduledAt     DateTime
  durationMinutes Int
  location        String?
  meetingLink     String?
  score           Decimal?        @db.Decimal(5, 2)
  feedback        String?
  status          InterviewStatus @default(SCHEDULED)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  application Application          @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  scorecards  InterviewScorecard[]
}

model InterviewScorecard {
  id          String  @id @default(uuid())
  interviewId String
  competency  String
  score       Int // 1-5
  notes       String?

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@index([interviewId])
}

model Offer {
  id                 String      @id @default(uuid())
  applicationId      String
  version            Int         @default(1)
  baseSalary         Decimal     @db.Decimal(18, 2)
  allowance          Decimal?    @db.Decimal(18, 2)
  benefitDescription String?
  joinDate           DateTime
  status             OfferStatus @default(DRAFT)
  sentAt             DateTime?
  acceptedAt         DateTime?
  rejectedAt         DateTime?
  notes              String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, version])
}

model OnboardingDocument {
  id            String   @id @default(uuid())
  applicationId String
  docType       String
  fileUrl       String
  uploadedAt    DateTime @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

// Onboarding checklist tasks span cross-functional teams (HR, IT, Finance).
// BR-06: a task may only be marked complete by its assigned owner team/employee,
// not unilaterally by HR Admin.
model OnboardingTask {
  id              String               @id @default(uuid())
  tenantId        String
  employeeId      String // the new hire the task belongs to
  applicationId   String?
  title           String
  description     String?
  ownerTeam       OnboardingOwnerTeam // HR, IT, FINANCE
  ownerEmployeeId String? // specific assignee (Employee id); if null, any member of ownerTeam may complete
  status          OnboardingTaskStatus @default(PENDING)
  completedBy     String? // employeeId of the completer (must belong to ownerTeam)
  completedAt     DateTime?
  dueDate         DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId, employeeId])
  @@index([tenantId, status])
}

enum OnboardingOwnerTeam {
  HR
  IT
  FINANCE
}

enum OnboardingTaskStatus {
  PENDING
  DONE
}

// =======================================================================
// ASSET MANAGEMENT
// =======================================================================

model Asset {
  id            String         @id @default(uuid())
  tenantId      String
  name          String
  code          String
  category      AssetCategory // LAPTOP, PHONE, VEHICLE, CARD, OTHER
  brand         String?
  model         String?
  serialNumber  String?
  purchaseDate  DateTime?
  purchasePrice Decimal?       @db.Decimal(18, 2)
  condition     AssetCondition @default(GOOD)
  status        AssetStatus    @default(AVAILABLE)
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?

  assignments AssetAssignment[]

  @@unique([tenantId, code])
}

model AssetAssignment {
  id                String    @id @default(uuid())
  assetId           String
  employeeId        String
  assignedAt        DateTime  @default(now())
  returnedAt        DateTime?
  conditionOnReturn String?
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  asset    Asset    @relation(fields: [assetId], references: [id], onDelete: Restrict)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
}

// =======================================================================
// EXPENSE CLAIM & LOAN MANAGEMENT
// =======================================================================

model ExpenseClaim {
  id          String        @id @default(uuid())
  tenantId    String
  employeeId  String
  title       String
  description String?
  totalAmount Decimal       @db.Decimal(18, 2)
  currency    String        @default("IDR")
  status      RequestStatus @default(PENDING)
  submittedAt DateTime?
  approvedBy  String?
  approvedAt  DateTime?
  paidAt      DateTime?
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  employee Employee      @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  items    ExpenseItem[]
}

model ExpenseItem {
  id          String          @id @default(uuid())
  claimId     String
  category    ExpenseCategory // TRAVEL, MEAL, ENTERTAINMENT, OFFICE, OTHER
  description String
  amount      Decimal         @db.Decimal(18, 2)
  receiptUrl  String?
  date        DateTime?
  createdAt   DateTime        @default(now())

  claim ExpenseClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
}

model Loan {
  id                 String        @id @default(uuid())
  tenantId           String
  employeeId         String
  amount             Decimal       @db.Decimal(18, 2)
  installmentCount   Int
  installmentAmount  Decimal       @db.Decimal(18, 2)
  purpose            String?
  status             RequestStatus @default(PENDING)
  approvedBy         String?
  approvedAt         DateTime?
  startDeductionFrom String? // payroll period
  remainingBalance   Decimal       @db.Decimal(18, 2)
  notes              String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  employee     Employee          @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  installments LoanInstallment[]
}

model LoanInstallment {
  id           String            @id @default(uuid())
  loanId       String
  periodName   String
  amount       Decimal           @db.Decimal(18, 2)
  status       InstallmentStatus @default(PENDING)
  paidAt       DateTime?
  payrollRunId String?
  createdAt    DateTime          @default(now())

  loan Loan @relation(fields: [loanId], references: [id], onDelete: Cascade)
}

// =======================================================================
// BENEFIT MANAGEMENT
// =======================================================================

model Benefit {
  id          String      @id @default(uuid())
  tenantId    String
  name        String
  code        String
  type        BenefitType // ALLOWANCE, INSURANCE, FACILITY, OTHER
  description String?
  isTaxable   Boolean     @default(true)
  value       Decimal?    @db.Decimal(18, 2)
  frequency   String? // MONTHLY, YEARLY, ONE_TIME
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?

  employeeBenefits EmployeeBenefit[]
  eligibilityRules BenefitEligibilityRule[]
}

model EmployeeBenefit {
  id            String        @id @default(uuid())
  tenantId      String
  employeeId    String
  benefitId     String
  value         Decimal?      @db.Decimal(18, 2)
  effectiveDate DateTime      @default(now())
  expiryDate    DateTime?
  status        BenefitStatus @default(ACTIVE)
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  employee   Employee                   @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  benefit    Benefit                    @relation(fields: [benefitId], references: [id], onDelete: Restrict)
  components EmployeeBenefitComponent[]
}

model EmployeeBenefitComponent {
  id                 String  @id @default(uuid())
  employeeBenefitId  String
  payrollComponentId String
  amount             Decimal @db.Decimal(18, 2)

  employeeBenefit  EmployeeBenefit  @relation(fields: [employeeBenefitId], references: [id], onDelete: Cascade)
  payrollComponent PayrollComponent @relation(fields: [payrollComponentId], references: [id], onDelete: Restrict)
}

// =======================================================================
// PERFORMANCE MANAGEMENT
// =======================================================================

model ReviewCycle {
  id        String          @id @default(uuid())
  tenantId  String
  name      String
  period    String // Q1_2026, H1_2026, YEARLY_2026
  startDate DateTime
  endDate   DateTime
  type      ReviewCycleType // QUARTERLY, SEMI_ANNUAL, ANNUAL
  status    CycleStatus     @default(UPCOMING)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  reviews             PerformanceReview[]
  calibrationSessions CalibrationSession[]
  finalScores         FinalScore[]
  feedback360s        Feedback360[]
  idps                IndividualDevelopmentPlan[]
}

model PerformanceReview {
  id           String       @id @default(uuid())
  tenantId     String
  cycleId      String
  employeeId   String
  reviewerId   String
  overallScore Decimal?     @db.Decimal(5, 2)
  summary      String?
  strengths    String?
  improvements String?
  status       ReviewStatus @default(PENDING)
  submittedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  cycle    ReviewCycle @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  employee Employee    @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  ratings  Rating[]
  goals    Goal[]
}

model Rating {
  id          String   @id @default(uuid())
  reviewId    String
  competency  String
  score       Decimal  @db.Decimal(5, 2)
  description String?
  createdAt   DateTime @default(now())

  review PerformanceReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
}

model Goal {
  id               String     @id @default(uuid())
  tenantId         String
  employeeId       String
  reviewId         String?
  title            String
  description      String?
  metric           String?
  targetValue      Decimal?   @db.Decimal(18, 2)
  actualValue      Decimal?   @db.Decimal(18, 2)
  startDate        DateTime?
  endDate          DateTime?
  status           GoalStatus @default(NOT_STARTED)
  // BR-02: goals created after >50% of the cycle elapsed require HRBP approval before they become active
  approvalRequired Boolean    @default(false)
  approvedById     String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  employee   Employee           @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  review     PerformanceReview? @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  approvedBy Employee?          @relation("goal_approver", fields: [approvedById], references: [id], onDelete: Restrict)
}

model CalibrationSession {
  id            String   @id @default(uuid())
  reviewCycleId String
  departmentId  String
  facilitatorId String
  status        String   @default("scheduled") // scheduled, in_progress, finalized
  createdAt     DateTime @default(now())

  cycle       ReviewCycle @relation(fields: [reviewCycleId], references: [id], onDelete: Cascade)
  department  Department  @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  facilitator Employee    @relation("calibration_facilitator", fields: [facilitatorId], references: [id], onDelete: Restrict)
}

model FinalScore {
  id            String   @id @default(uuid())
  employeeId    String
  reviewCycleId String
  finalRating   Decimal  @db.Decimal(3, 1)
  calibratedBy  String
  finalizedAt   DateTime @default(now())

  employee         Employee          @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  cycle            ReviewCycle       @relation(fields: [reviewCycleId], references: [id], onDelete: Cascade)
  calibrator       Employee          @relation("final_score_calibrator", fields: [calibratedBy], references: [id], onDelete: Restrict)
  movementRequests MovementRequest[] @relation("movement_performance_ref")

  @@unique([employeeId, reviewCycleId])
}

// =======================================================================
// SUCCESSION PLANNING
// =======================================================================

model TalentPool {
  id          String           @id @default(uuid())
  tenantId    String
  name        String
  description String?
  criteria    String?
  status      TalentPoolStatus @default(ACTIVE)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?

  tenant  Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  members TalentPoolMember[]

  @@unique([tenantId, name])
  @@index([tenantId, status])
}

model TalentPoolMember {
  id              String          @id @default(uuid())
  poolId          String
  employeeId      String
  performanceBand String? // HIGH, MID, LOW
  potentialBand   String? // HIGH, MID, LOW
  readiness       TalentReadiness @default(NOT_READY)
  notes           String?
  addedById       String
  addedAt         DateTime        @default(now())

  pool     TalentPool @relation(fields: [poolId], references: [id], onDelete: Cascade)
  employee Employee   @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  addedBy  User       @relation(fields: [addedById], references: [id], onDelete: Restrict)

  @@unique([poolId, employeeId])
  @@index([poolId])
}

model SuccessionPlan {
  id                String               @id @default(uuid())
  tenantId          String
  positionId        String
  departmentId      String?
  currentEmployeeId String? // incumbent
  status            SuccessionPlanStatus @default(DRAFT)
  riskCode          String? // LOW / MEDIUM / HIGH (vacancy risk)
  targetReadyDate   DateTime?
  notes             String?
  createdById       String
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  deletedAt         DateTime?

  tenant        Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  position      Position              @relation(fields: [positionId], references: [id], onDelete: Restrict)
  department    Department?           @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  currentHolder Employee?             @relation("succession_incumbent", fields: [currentEmployeeId], references: [id], onDelete: Restrict)
  createdBy     User                  @relation("succession_creator", fields: [createdById], references: [id], onDelete: Restrict)
  candidates    SuccessionCandidate[]

  @@unique([tenantId, positionId])
  @@index([tenantId, status])
}

model SuccessionCandidate {
  id              String          @id @default(uuid())
  planId          String
  employeeId      String
  readiness       TalentReadiness @default(NOT_READY)
  rank            Int             @default(0)
  assessmentNotes String?
  decision        String? // PROMOTED / PENDING / NOT_SELECTED
  addedById       String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  plan     SuccessionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  employee Employee       @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  addedBy  User           @relation("succession_candidate_adder", fields: [addedById], references: [id], onDelete: Restrict)

  @@unique([planId, employeeId])
  @@index([planId])
}

// =======================================================================
// LEARNING MANAGEMENT
// =======================================================================

model Training {
  id          String         @id @default(uuid())
  tenantId    String
  title       String
  description String?
  category    String?        @default("GENERAL") // GENERAL, K3, MANAGEMENT, COMPLIANCE
  type        TrainingType // INTERNAL, EXTERNAL, ONLINE, CERTIFICATION
  provider    String?
  startDate   DateTime
  endDate     DateTime
  cost        Decimal?       @db.Decimal(18, 2)
  capacity    Int?
  status      TrainingStatus @default(PLANNED)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  participants                   TrainingParticipant[]
  recommendedViolationCategory   ViolationCategory?    @relation("recommended_k3_training", fields: [recommendedViolationCategoryId], references: [id], onDelete: Restrict)
  recommendedViolationCategoryId String?

  // LMS enhancements
  courseId String?
  course   Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

// LMS Course — structured learning path with modules and lessons
model Course {
  id          String   @id @default(uuid())
  tenantId    String
  title       String
  description String?
  category    String?  @default("GENERAL")
  imageUrl    String?
  duration    Int? // duration in minutes
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  modules   CourseModule[]
  trainees  CourseTrainee[]
  trainings Training[]
}

model CourseModule {
  id          String   @id @default(uuid())
  courseId    String
  title       String
  description String?
  order       Int      @default(0)
  duration    Int? // minutes
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]
}

model Lesson {
  id          String   @id @default(uuid())
  moduleId    String
  title       String
  content     String? // HTML/text content or URL to video/material
  contentType String?  @default("TEXT") // TEXT, VIDEO, PDF, LINK
  duration    Int? // minutes
  order       Int      @default(0)
  isRequired  Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  module  CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  quizzes Quiz[]
}

model Quiz {
  id              String   @id @default(uuid())
  lessonId        String
  title           String
  description     String?
  maxScore        Int      @default(100)
  passingScore    Int      @default(70)
  timeLimit       Int? // minutes
  attemptsAllowed Int      @default(3)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  lesson    Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions QuizQuestion[]
  attempts  QuizAttempt[]
}

model QuizQuestion {
  id            String   @id @default(uuid())
  quizId        String
  question      String
  questionType  String   @default("MULTIPLE_CHOICE") // MULTIPLE_CHOICE, TRUE_FALSE, SHORT_ANSWER
  options       String? // JSON array for multiple choice
  correctAnswer String
  points        Int      @default(1)
  order         Int      @default(0)
  createdAt     DateTime @default(now())

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
}

model QuizAttempt {
  id          String    @id @default(uuid())
  quizId      String
  traineeId   String
  score       Int
  passed      Boolean
  answers     String // JSON: { questionId: answer, ... }
  submittedAt DateTime  @default(now())
  completedAt DateTime?

  quiz    Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  trainee Employee @relation(fields: [traineeId], references: [id], onDelete: Restrict)

  @@unique([quizId, traineeId])
}

model CourseTrainee {
  id          String                 @id @default(uuid())
  courseId    String
  employeeId  String
  status      CourseEnrollmentStatus @default(ENROLLED) // ENROLLED, IN_PROGRESS, COMPLETED, DROPPED
  progress    Int                    @default(0) // percentage
  score       Decimal?               @db.Decimal(5, 2)
  enrolledAt  DateTime               @default(now())
  completedAt DateTime?

  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([courseId, employeeId])
}

// 360° Feedback
model Feedback360 {
  id            String               @id @default(uuid())
  tenantId      String
  reviewCycleId String
  revieweeId    String
  reviewerId    String // the person giving feedback
  reviewerType  FeedbackReviewerType // SELF, MANAGER, PEER, DIRECT_REPORT, CUSTOM
  status        FeedbackStatus       @default(PENDING)
  submittedAt   DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  cycle    ReviewCycle @relation(fields: [reviewCycleId], references: [id], onDelete: Restrict)
  reviewee Employee    @relation("feedback_reviewee", fields: [revieweeId], references: [id], onDelete: Restrict)
  reviewer Employee    @relation("feedback_reviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  questions Feedback360Question[]

  @@unique([reviewCycleId, revieweeId, reviewerId])
}

model Feedback360Question {
  id            String   @id @default(uuid())
  feedback360Id String
  questionText  String
  questionType  String   @default("LIKERT_5") // LIKERT_5, NA, TEXT
  rating        Int? // 1-5 for Likert
  comment       String?
  order         Int      @default(0)
  createdAt     DateTime @default(now())

  feedback360 Feedback360 @relation(fields: [feedback360Id], references: [id], onDelete: Cascade)
}

// Individual Development Plan
model IndividualDevelopmentPlan {
  id            String    @id @default(uuid())
  tenantId      String
  employeeId    String
  reviewCycleId String?
  title         String
  description   String?
  skillsGap     String? // JSON: identified skill gaps
  objectives    String // JSON array of development objectives
  startDate     DateTime
  endDate       DateTime
  status        IDPStatus @default(DRAFT) // DRAFT, ACTIVE, COMPLETED, CANCELLED
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  employee Employee?    @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  cycle    ReviewCycle? @relation(fields: [reviewCycleId], references: [id], onDelete: Restrict)
  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  activities IDPActivity[]

  @@index([tenantId, employeeId])
}

model IDPActivity {
  id          String            @id @default(uuid())
  idpId       String
  title       String
  description String?
  type        IDPActivityType   @default(TRAINING) // TRAINING, MENTORING, PROJECT, CERTIFICATION, SELF_STUDY, CROSS_TRAINING
  targetDate  DateTime?
  status      IDPActivityStatus @default(PENDING) // PENDING, IN_PROGRESS, COMPLETED
  progress    Int               @default(0) // percentage
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  idp IndividualDevelopmentPlan @relation(fields: [idpId], references: [id], onDelete: Cascade)
}

// UMK/UMP Provincial Minimum Wage
model ProvincialMinimumWage {
  id            String   @id @default(uuid())
  tenantId      String
  province      String
  year          Int
  minimumWage   Decimal  @db.Decimal(18, 2)
  effectiveDate DateTime
  source        String? // government regulation reference
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, province, year])
  @@index([tenantId, province])
}

model TrainingParticipant {
  id          String            @id @default(uuid())
  trainingId  String
  employeeId  String
  status      ParticipantStatus @default(REGISTERED)
  score       Decimal?          @db.Decimal(5, 2)
  completedAt DateTime?
  feedback    String?
  createdAt   DateTime          @default(now())

  training Training @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([trainingId, employeeId])
}

model Certification {
  id             String    @id @default(uuid())
  tenantId       String
  employeeId     String
  name           String
  issuer         String?
  issuedDate     DateTime
  expiryDate     DateTime?
  certificateUrl String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
}

// =======================================================================
// RESIGNATION & OFFBOARDING
// =======================================================================

model ResignationRequest {
  id              String          @id @default(uuid())
  tenantId        String
  employeeId      String
  type            ResignationType @default(RESIGNATION) // RESIGNATION, RETIREMENT, TERMINATION
  reason          String
  resignationDate DateTime
  effectiveDate   DateTime
  status          RequestStatus   @default(PENDING)
  approvedBy      String?
  approvedAt      DateTime?
  rejectedReason  String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  employee             Employee              @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  exitInterview        ExitInterview?
  offboardingTasks     OffboardingTask[]
  finalSettlement      FinalSettlement?
  ClearanceCertificate ClearanceCertificate?
}

model ExitInterview {
  id                  String   @id @default(uuid())
  resignationId       String   @unique
  reason              String
  feedback            String?
  wouldRecommend      Boolean?
  areasForImprovement String?
  conductedBy         String
  conductedAt         DateTime
  createdAt           DateTime @default(now())

  resignation ResignationRequest @relation(fields: [resignationId], references: [id], onDelete: Cascade)
}

model OffboardingTask {
  id            String              @id @default(uuid())
  resignationId String
  taskName      String
  assignedTo    String
  category      OffboardingCategory @default(ASSET)
  status        TaskStatus          @default(PENDING)
  completedAt   DateTime?
  notes         String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  resignation ResignationRequest @relation(fields: [resignationId], references: [id], onDelete: Cascade)
}

model FinalSettlement {
  id                String   @id @default(uuid())
  resignationId     String   @unique
  unusedLeavePayout Decimal  @default(0) @db.Decimal(18, 2)
  severanceAmount   Decimal  @default(0) @db.Decimal(18, 2)
  loanDeduction     Decimal  @default(0) @db.Decimal(18, 2)
  netPayout         Decimal  @default(0) @db.Decimal(18, 2)
  status            String   @default("draft") // draft, reviewed, paid
  createdAt         DateTime @default(now())

  resignation ResignationRequest @relation(fields: [resignationId], references: [id], onDelete: Cascade)
}

model ClearanceCertificate {
  id            String    @id @default(uuid())
  tenantId      String
  resignationId String    @unique
  employeeId    String
  issuedBy      String
  issuedAt      DateTime  @default(now())
  validUntil    DateTime?
  status        String    @default("draft") // draft, issued, revoked
  reason        String // reason for leaving: RESIGNATION, RETIREMENT, TERMINATION, END_OF_CONTRACT
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  resignation ResignationRequest @relation(fields: [resignationId], references: [id], onDelete: Cascade)
  employee    Employee           @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([tenantId, employeeId])
  @@index([tenantId, status])
}

model Alumni {
  id                   String    @id @default(uuid())
  tenantId             String
  employeeId           String
  employeeCode         String
  fullName             String
  lastPosition         String?
  lastDepartment       String?
  lastGrade            String?
  resignationDate      DateTime
  resignationType      String
  personalEmail        String?
  personalPhone        String?
  linkedinUrl          String?
  currentCompany       String?
  currentPosition      String?
  isAvailableForRehire Boolean   @default(true)
  referralCount        Int       @default(0)
  notes                String?
  joinedAt             DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId, employeeId])
  @@index([tenantId, isAvailableForRehire])
}

model MovementRequest {
  id                     String   @id @default(uuid())
  employeeId             String
  type                   String // promotion, transfer, mutation
  newPositionId          String?
  newDepartmentId        String?
  newOrganizationId      String?
  effectiveDate          DateTime
  status                 String   @default("pending") // pending, approved, rejected
  performanceReviewRefId String? // FK to FinalScore
  createdAt              DateTime @default(now())

  employee          Employee      @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  newPosition       Position?     @relation(fields: [newPositionId], references: [id], onDelete: Restrict)
  newDepartment     Department?   @relation("DeptMovementRequests", fields: [newDepartmentId], references: [id], onDelete: Restrict)
  newOrganization   Organization? @relation("OrgMovementRequests", fields: [newOrganizationId], references: [id], onDelete: Restrict)
  performanceReview FinalScore?   @relation("movement_performance_ref", fields: [performanceReviewRefId], references: [id], onDelete: Restrict)

  @@index([employeeId])
}

model BenefitEligibilityRule {
  id           String   @id @default(uuid())
  benefitId    String
  gradeId      String?
  departmentId String?
  createdAt    DateTime @default(now())

  benefit    Benefit     @relation(fields: [benefitId], references: [id], onDelete: Cascade)
  grade      Grade?      @relation(fields: [gradeId], references: [id], onDelete: Restrict)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)
}

model EssNotification {
  id         String    @id @default(uuid())
  employeeId String
  type       String
  message    String
  readStatus Boolean   @default(false)
  archivedAt DateTime? // BR-05: archived after retention window, hidden from default list
  createdAt  DateTime  @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([employeeId, readStatus])
}

model EssOnboardingProgress {
  id                 String    @id @default(uuid())
  employeeId         String    @unique
  tourCompleted      Boolean   @default(false)
  profileConfirmedAt DateTime?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
}

model EssPreference {
  id                   String   @id @default(uuid())
  employeeId           String   @unique
  language             String   @default("id")
  theme                String   @default("light")
  notificationSettings Json     @default("{}")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
}

// BR-02: sensitive profile changes (NPWP, BPJS) require HR Admin approval
// before taking effect; basic contact data is applied directly via updateProfile.
model EssProfileChangeRequest {
  id          String    @id @default(uuid())
  tenantId    String
  employeeId  String
  fields      Json // sensitive fields requested (taxIdNumber, socialSecurityNumber)
  status      String    @default("PENDING") // PENDING | APPROVED | REJECTED
  note        String?
  requestedAt DateTime  @default(now())
  reviewedBy  String?
  reviewedAt  DateTime?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([tenantId, status])
}

