}

model EmployeeBenefit {
  id            String        @id @default(uuid())
  tenantId      String
  employeeId    String
  benefitId     String
  value         Decimal?      @db.Decimal(18, 2)
  effectiveDate DateTime      @default(now())
  expiryDate    DateTime?
  status        BenefitStatus @default(ACTIVE)
