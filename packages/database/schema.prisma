// EMPLOYEE ENGAGEMENT SURVEY — v1.0
// =======================================================================

model EngagementSurvey {
  id          String       @id @default(uuid())
  tenantId    String
  title       String
  type        SurveyType   @default(PULSE)
  isAnonymous Boolean      @default(true)
  targetScope String? // JSON: department_ids, grade_ids, etc.
  startDate   DateTime
  endDate     DateTime
  status      SurveyStatus @default(DRAFT)
  createdBy   String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  questions   SurveyQuestion[]
  responses   SurveyResponse[]
  actionItems SurveyActionItem[]

  @@index([tenantId, status])
  @@index([tenantId, startDate, endDate])
}

model SurveyQuestion {
  id           String       @id @default(uuid())
  surveyId     String
  questionText String
  questionType QuestionType
  options      String? // JSON array for multiple choice
  isRequired   Boolean      @default(true)
  order        Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  survey    EngagementSurvey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  responses SurveyResponse[]

  @@index([surveyId, order])
}

model SurveyResponse {
  id           String   @id @default(uuid())
  surveyId     String
  questionId   String
  employeeId   String?
  respondentId String? // Anonymous dedup token — UUID generated per submission (null for identified)
  answerValue  String
  submittedAt  DateTime @default(now())

  survey   EngagementSurvey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  question SurveyQuestion   @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([surveyId, employeeId])
  @@index([surveyId, respondentId])
  @@index([questionId])
}

model SurveyActionItem {
  id          String       @id @default(uuid())
  surveyId    String
  title       String
  description String?
  assigneeId  String // User id of the action item owner
  dueDate     DateTime
  status      ActionStatus @default(PENDING)
  // QW-03: percent completion of the action plan (0-100). 100 auto-completes.
  progress       Int       @default(0)
  completedAt    DateTime? // set automatically when the item is COMPLETED
  reminderSentAt DateTime? // last overdue reminder dispatched to the assignee
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  survey EngagementSurvey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@index([surveyId, assigneeId])
  @@index([assigneeId, status])
  @@index([dueDate, status])
}

// =======================================================================
// MANPOWER PLANNING — v1.0
// =======================================================================

model ManpowerPlan {
  id           String             @id @default(uuid())
  tenantId     String
  departmentId String
  period       String // e.g., "2026-H1", "2026-Q3"
  version      Int                @default(1)
  status       ManpowerPlanStatus @default(DRAFT)
