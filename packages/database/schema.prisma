generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =======================================================================
// SYSTEM ADMINISTRATION - Shared Services
// =======================================================================

model Tenant {
  id        String   @id @default(uuid())
  name      String   @unique
  domain    String?  @unique
  package   PackageType @default(STANDARD)
  status    TenantStatus @default(ACTIVE)
  settings  Json?    @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  entities  TenantEntity[]
  users     User[]
  roles     Role[]
  featureFlags FeatureFlag[]
  workflows  WorkflowDefinition[]
  integrations Integration[]
  auditLogs AuditLog[]
}

model TenantEntity {
  id         String   @id @default(uuid())
  tenantId   String
  name       String
  code       String
  parentId   String?
  address    String?
  city       String?
  province   String?
  postalCode String?
  timezone   String   @default("Asia/Jakarta")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deletedAt  DateTime?

  tenant Tenant     @relation(fields: [tenantId], references: [id])
  parent TenantEntity? @relation("EntityHierarchy", fields: [parentId], references: [id])
  children TenantEntity[] @relation("EntityHierarchy")

  employees Employee[]
  departments Department[]
  holidayCalendars HolidayCalendar[]
  workLocations WorkLocation[]

  @@unique([tenantId, code])
}

model User {
  id           String   @id @default(uuid())
  tenantId     String
  email        String
  passwordHash String?
  fullName     String
  phone        String?
  avatar       String?
  locale       String   @default("id")
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  mfaEnabled   Boolean  @default(false)
  mfaSecret    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  tenant     Tenant @relation(fields: [tenantId], references: [id])
  employeeId String? @unique
  employee   Employee? @relation(fields: [employeeId], references: [id])

  userRoles   UserRole[]
  notifications Notification[]
  auditLogs   AuditLog[]

  @@unique([tenantId, email])
}

model Role {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  tenant    Tenant @relation(fields: [tenantId], references: [id])
  userRoles UserRole[]
  rolePermissions RolePermission[]

  @@unique([tenantId, name])
}

model Permission {
  id          String   @id @default(uuid())
  module      String
  action      String   // create, read, update, delete, approve
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@unique([module, action])
}

model RolePermission {
  roleId       String
  permissionId String
  scope        String? @default("ALL") // ALL, OWN, DEPARTMENT

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId String
  roleId String
  entityId String? // data scope restriction

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model FeatureFlag {
  id        String  @id @default(uuid())
  tenantId  String
  module    String
  feature   String
  enabled   Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, feature])
}

model Integration {
  id            String   @id @default(uuid())
  tenantId      String
  name          String
  type          String   // BPJS, BANK, BIOMETRIC, etc
  credentials   String   // encrypted
  status        IntegrationStatus @default(ACTIVE)
  lastSyncAt    DateTime?
  errorMessage  String?
  config        Json?    @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant        Tenant @relation(fields: [tenantId], references: [id])
}

// =======================================================================
// WORKFLOW ENGINE
// =======================================================================

model WorkflowDefinition {
  id          String   @id @default(uuid())
  tenantId    String
  code        String   // LEAVE_APPROVAL, PAYROLL_APPROVAL, etc
  name        String
  description String?
  version     Int      @default(1)
  status      WorkflowStatus @default(ACTIVE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  steps  WorkflowStep[]
  instances WorkflowInstance[]

  @@unique([tenantId, code, version])
}

model WorkflowStep {
  id              String @id @default(uuid())
  workflowDefId   String
  stepOrder       Int
  name            String
  approverType    ApproverType // DIRECT_MANAGER, ROLE, SPECIFIC_USER
  approverRoleId  String?
  approverUserId  String?
  condition       Json?   @default("{}")
  timeoutHours    Int?    @default(48)
  escalationStep  Int?

  workflowDefinition WorkflowDefinition @relation(fields: [workflowDefId], references: [id], onDelete: Cascade)
}

model WorkflowInstance {
  id             String   @id @default(uuid())
  tenantId       String
  workflowDefId  String
  entityType     String   // LEAVE_REQUEST, EXPENSE_CLAIM, etc
  entityId       String
  status         WorkflowInstanceStatus @default(PENDING)
  currentStep    Int      @default(1)
  initiatedBy    String
  initiatedAt    DateTime @default(now())
  completedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workflowDefinition WorkflowDefinition @relation(fields: [workflowDefId], references: [id])
  approvals      WorkflowApproval[]
}

model WorkflowApproval {
  id             String   @id @default(uuid())
  workflowInstId String
  stepOrder      Int
  approverId     String
  status         ApprovalStatus @default(PENDING)
  notes          String?
  actedAt        DateTime?
  createdAt      DateTime @default(now())

  workflowInstance WorkflowInstance @relation(fields: [workflowInstId], references: [id], onDelete: Cascade)
}

// =======================================================================
// NOTIFICATION
// =======================================================================

model Notification {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String
  channel   String   // EMAIL, PUSH, IN_APP, SMS
  templateKey String
  title     String
  body      String
  payload   Json?
  status    NotificationStatus @default(PENDING)
  readAt    DateTime?
  sentAt    DateTime?
  failedAt  DateTime?
  errorMessage String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

// =======================================================================
// AUDIT LOG
// =======================================================================

model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String
  module    String
  entity    String
  entityId  String
  action    String   // CREATE, UPDATE, DELETE, APPROVE, REJECT
  changedBy String
  changedAt DateTime @default(now())
  oldValue  Json?
  newValue  Json?
  ipAddress String?
  userAgent String?

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [changedBy], references: [id])

  @@index([tenantId, module, entity, entityId])
  @@index([tenantId, changedAt])
}

// =======================================================================
// EMPLOYEE & ORGANIZATION MANAGEMENT
// =======================================================================

model Employee {
  id               String   @id @default(uuid())
  tenantId         String
  employeeId       String   // configurable format per tenant
  fullName         String
  email            String
  phone            String?
  alternativePhone String?
  birthDate        DateTime?
  birthPlace       String?
  gender           Gender?
  religion         String?
  maritalStatus    MaritalStatus @default(SINGLE)
  idCardNumber     String?  // NIK (encrypted)
  taxIdNumber      String?  // NPWP (encrypted)
  socialSecurityNumber String? // BPJS (encrypted)
  bloodType        String?
  allergies        String?
  medicalNotes     String?  // encrypted
  address          String?
  city             String?
  province         String?
  postalCode       String?
  emergencyContact String?
  emergencyPhone   String?
  profilePicture   String?
  status           EmployeeStatus @default(PENDING_ACTIVATION)
  startDate        DateTime?
  endDate          DateTime?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  deletedAt        DateTime?

  tenantEntity TenantEntity @relation(fields: [tenantId], references: [id]) // via tenantId ref
  user         User?
  employments  Employment[]
  documents    EmployeeDocument[]
  attendanceRecords AttendanceRecord[]
  rosterEntries     RosterEntry[]
  overtimeRequests  OvertimeRequest[]
  leaveRequests     LeaveRequest[]
  leaveBalances     LeaveBalance[]
  payslips          Payslip[]
  performanceReviews PerformanceReview[]
  goals            Goal[]
  expenseClaims    ExpenseClaim[]
  assetAssignments AssetAssignment[]
  employeeBenefits EmployeeBenefit[]
  loans            Loan[]
  resignationRequests ResignationRequest[]
  trainingParticipants TrainingParticipant[]
  certifications   Certification[]
  applications     Application[]
  contact          EmployeeContact?
  medical          EmployeeMedical?
  attendanceCorrectionsRequested AttendanceCorrection[] @relation("correction_requester")
  attendanceCorrectionsApproved AttendanceCorrection[] @relation("correction_approver")
  calibrationSessionsFacilitated CalibrationSession[] @relation("calibration_facilitator")
  finalScoresCalibrated          FinalScore[]          @relation("final_score_calibrator")
  payrollAdjustments             PayrollAdjustment[]
  finalScores                    FinalScore[]
  movementRequests               MovementRequest[]
  essNotifications               EssNotification[]
  essOnboardingProgress          EssOnboardingProgress?
  essPreference                  EssPreference?
  salaryComponents               SalaryComponent[]
  payrollRunItems                PayrollRunItem[]
  jobRequisitionsApproved        JobRequisition[] @relation("requisition_approver")
  workLocationId                 String?
  workLocation                   WorkLocation?    @relation(fields: [workLocationId], references: [id])

  @@unique([tenantId, employeeId])
  @@unique([tenantId, email])
  @@index([tenantId, status])
  @@index([workLocationId])
}

model Employment {
  id            String   @id @default(uuid())
  employeeId    String
  positionId    String
  departmentId  String
  gradeId       String?
  entityId      String?
  type          EmploymentType @default(PERMANENT)
  startDate     DateTime
  endDate       DateTime?
  isActive      Boolean  @default(true)
  salary        Decimal? @db.Decimal(18, 2)
  salaryCurrency String  @default("IDR")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  employee   Employee   @relation(fields: [employeeId], references: [id])
  position   Position   @relation(fields: [positionId], references: [id])
  department Department @relation(fields: [departmentId], references: [id])
  grade      Grade?     @relation(fields: [gradeId], references: [id])
}

model EmployeeDocument {
  id          String   @id @default(uuid())
  employeeId  String
  type        DocumentType // KTP, NPWP, IJAZAH, KONTRAK, etc
  fileName    String
  fileUrl     String
  fileSize    Int?
  mimeType    String?
  version     Int      @default(1)
  status      DocumentStatus @default(ACTIVE)
  expiresAt   DateTime?
  notes       String?
  uploadedAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])
}

model EmployeeContact {
  id                    String   @id @default(uuid())
  employeeId            String
  phone                 String?
  address               String?
  emergencyContactName  String?
  emergencyContactPhone String?
  updatedAt             DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([employeeId])
}

model EmployeeMedical {
  id         String   @id @default(uuid())
  employeeId String
  bloodType  String?
  allergies  String?
  notes      String?
  updatedAt  DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([employeeId])
}

model Organization {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  code        String   @unique
  description String?
  parentId    String?
  level       Int      @default(0)
  headUserId  String?
  effectiveDate DateTime @default(now())
  status      OrgStatus @default(ACTIVE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  parent Organization? @relation("OrgHierarchy", fields: [parentId], references: [id])
  children Organization[] @relation("OrgHierarchy")
  departments Department[]

  @@index([tenantId])
}

model Department {
  id             String   @id @default(uuid())
  tenantId       String
  organizationId String
  entityId       String?
  name           String
  code           String
  headEmployeeId String?
  parentId       String?
  level          Int      @default(0)
  effectiveDate  DateTime @default(now())
  status         DeptStatus @default(ACTIVE)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  entity       TenantEntity? @relation(fields: [entityId], references: [id])
  parent       Department? @relation("DeptHierarchy", fields: [parentId], references: [id])
  children     Department[] @relation("DeptHierarchy")
  positions    Position[]
  benefitEligibilityRules BenefitEligibilityRule[]
  calibrationSessions     CalibrationSession[]
  requisitions            JobRequisition[]
  movementRequestsAsNew   MovementRequest[]
  employments  Employment[]

  @@unique([tenantId, code])
}

model Position {
  id           String   @id @default(uuid())
  tenantId     String
  departmentId String
  name         String
  code         String
  gradeId      String?
  description  String?
  isHead       Boolean  @default(false)
  maxHeadCount Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  department   Department @relation(fields: [departmentId], references: [id])
  grade        Grade?     @relation(fields: [gradeId], references: [id])
  employments  Employment[]
  movementRequestsAsNewPosition MovementRequest[]

  @@unique([tenantId, code])
}

model Grade {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  code        String
  level       Int
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  positions   Position[]
  employments Employment[]
  benefitEligibilityRules BenefitEligibilityRule[]

  @@unique([tenantId, code])
}

// =======================================================================
// ATTENDANCE & LEAVE MANAGEMENT
// =======================================================================

model Shift {
  id            String   @id @default(uuid())
  tenantId      String
  name          String
  code          String
  startTime     String   // HH:mm
  endTime       String   // HH:mm
  breakStart    String?
  breakEnd      String?
  gracePeriodMinutes Int? @default(15)
  lateThresholdMinutes Int? @default(30)
  earlyLeaveThresholdMinutes Int? @default(15)
  overtimeBeforeMinutes Int? @default(0)
  overtimeAfterMinutes  Int? @default(0)
  color         String?  @default("#3B82F6")
  isNightShift  Boolean  @default(false)
  status        ShiftStatus @default(ACTIVE)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  rosterEntries RosterEntry[]
}

model Roster {
  id              String   @id @default(uuid())
  tenantId        String
  name            String
  description     String?
  startDate       DateTime
  endDate         DateTime
  rotationPattern Json?    // [{day: 0, shiftId: "..."}]
  status          RosterStatus @default(ACTIVE)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  entries RosterEntry[]
}

model RosterEntry {
  id        String @id @default(uuid())
  rosterId  String
  employeeId String
  shiftId   String
  date      DateTime
  status    RosterEntryStatus @default(SCHEDULED)

  roster   Roster   @relation(fields: [rosterId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id])
  shift    Shift    @relation(fields: [shiftId], references: [id])

  @@unique([employeeId, date])
}

model HolidayCalendar {
  id        String   @id @default(uuid())
  tenantId  String
  entityId  String?
  name      String
  date      DateTime
  type      HolidayType @default(NATIONAL)
  isRecurring Boolean @default(false)
  description String?
  createdAt DateTime @default(now())

  entity TenantEntity? @relation(fields: [entityId], references: [id])

  @@unique([tenantId, date, entityId])
}

model AttendanceRecord {
  id            String   @id @default(uuid())
  tenantId      String
  employeeId    String
  date          DateTime
  clockIn       DateTime?
  clockOut      DateTime?
  clockInMethod String?  // GPS, QR, FACE, FINGERPRINT, MANUAL
  clockOutMethod String?
  clockInLat    Decimal? @db.Decimal(10, 8)
  clockInLng    Decimal? @db.Decimal(11, 8)
  clockOutLat   Decimal? @db.Decimal(10, 8)
  clockOutLng   Decimal? @db.Decimal(11, 8)
  clockInPhoto  String?
  clockOutPhoto String?
  shiftId       String?
  status        AttendanceStatus @default(PRESENT)
  lateMinutes   Int?
  earlyLeaveMinutes Int?
  overtimeMinutes  Int?
  notes         String?
  isApproved    Boolean  @default(false)
  approvedBy    String?
  approvedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])
  corrections AttendanceCorrection[]

  @@unique([employeeId, date])
  @@index([tenantId, date, status])
}

model AttendanceCorrection {
  id            String       @id @default(uuid())
  attendanceId  String
  requestedBy   String
  reason        String
  proposedClockIn  DateTime?
  proposedClockOut DateTime?
  status        RequestStatus @default(PENDING)
  approvedBy    String?
  createdAt     DateTime     @default(now())

  attendance AttendanceRecord @relation(fields: [attendanceId], references: [id])
  requester  Employee         @relation("correction_requester", fields: [requestedBy], references: [id])
  approver   Employee?        @relation("correction_approver", fields: [approvedBy], references: [id])

  @@index([attendanceId])
}

model WorkLocation {
  id           String       @id @default(uuid())
  tenantId     String
  name         String
  latitude     Decimal      @db.Decimal(10, 8)
  longitude    Decimal      @db.Decimal(11, 8)
  radiusMeters Int          @default(100)
  isFlexible   Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  employees    Employee[]
  tenant       TenantEntity @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model OvertimeRequest {
  id            String   @id @default(uuid())
  tenantId      String
  employeeId    String
  date          DateTime
  startTime     DateTime
  endTime       DateTime
  totalMinutes  Int
  reason        String
  status        RequestStatus @default(PENDING)
  approvedBy    String?
  approvedAt    DateTime?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])
}

model LeaveType {
  id              String   @id @default(uuid())
  tenantId        String
  name            String
  code            String
  description     String?
  isPaid          Boolean  @default(true)
  allowNegativeBalance Boolean @default(false)
  maxConsecutiveDays Int?
  requiresDocument Boolean @default(false)
  carryForwardLimit Int?    @default(0)
  carryForwardExpiry String? // e.g. "Q1_NEXT_YEAR"
  genderRestriction Gender?
  minServiceMonths Int?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  leaveRequests  LeaveRequest[]
  leaveBalances  LeaveBalance[]
}

model LeaveBalance {
  id          String   @id @default(uuid())
  tenantId    String
  employeeId  String
  leaveTypeId String
  year        Int
  totalEntitled Decimal @db.Decimal(5, 2)
  totalUsed   Decimal  @db.Decimal(5, 2) @default(0)
  totalPending Decimal @db.Decimal(5, 2) @default(0)
  carryForward Decimal @db.Decimal(5, 2) @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@unique([employeeId, leaveTypeId, year])
}

model LeaveRequest {
  id             String   @id @default(uuid())
  tenantId       String
  employeeId     String
  leaveTypeId    String
  startDate      DateTime
  endDate        DateTime
  totalDays      Decimal  @db.Decimal(5, 2)
  reason         String
  documentUrl    String?
  status         RequestStatus @default(PENDING)
  approvedBy     String?
  approvedAt     DateTime?
  rejectedReason String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@index([tenantId, status])
  @@index([employeeId, startDate])
}

// =======================================================================
// PAYROLL, BPJS & PPH21 MANAGEMENT
// =======================================================================

model PayrollComponent {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  code        String
  type        PayrollComponentType // ALLOWANCE, DEDUCTION, BPJS_KES, BPJS_KET, PPH21
  category    PayrollComponentCategory @default(FIXED)
  description String?
  formula     String?  // calculation formula
  isTaxable   Boolean  @default(true)
  isProrated  Boolean  @default(false)
  value       Decimal? @db.Decimal(18, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  payrollItems        PayrollItem[]
  employeeBenefitComponents EmployeeBenefitComponent[]
}

model PayrollAdjustment {
  id           String   @id @default(uuid())
  tenantId     String
  employeeId   String
  sourceEvent  String // canonical event name that produced this adjustment
  referenceId  String? // claimId / loanId / benefitTypeId / reviewCycleId / grade ids
  type         PayrollAdjustmentType // EARNING, DEDUCTION, SALARY_UPDATE
  amount       Decimal? @db.Decimal(18, 2)
  currency     String   @default("IDR")
  description  String?
  effectiveDate DateTime @default(now())
  expiresAt    DateTime?
  appliedRunId String? // set when consumed by a payroll run
  status       PayrollAdjustmentStatus @default(PENDING) // PENDING, APPLIED, CANCELLED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([tenantId, employeeId])
  @@index([tenantId, status])
}

model PayrollPeriod {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  startDate   DateTime
  endDate     DateTime
  status      PayrollPeriodStatus @default(OPEN)
  closedBy    String?
  closedAt    DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  payrollRuns PayrollRun[]
}

model PayrollRun {
  id            String   @id @default(uuid())
  tenantId      String
  periodId      String
  name          String
  status        PayrollRunStatus @default(DRAFT)
  totalEmployees Int     @default(0)
  totalAmount   Decimal  @db.Decimal(20, 2) @default(0)
  approvedBy    String?
  approvedAt    DateTime?
  processedAt   DateTime?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  period        PayrollPeriod @relation(fields: [periodId], references: [id])
  payslips      Payslip[]
  items         PayrollRunItem[]
  bankTransfers BankTransferBatch[]
}

model PayrollItem {
  id                String   @id @default(uuid())
  payslipId         String
  componentId       String
  amount            Decimal  @db.Decimal(18, 2)
  calculationBasis  String?
  description       String?
  createdAt         DateTime @default(now())

  payslip    Payslip         @relation(fields: [payslipId], references: [id], onDelete: Cascade)
  component  PayrollComponent @relation(fields: [componentId], references: [id])
}

model Payslip {
  id           String   @id @default(uuid())
  tenantId     String
  runId        String
  employeeId   String
  baseSalary   Decimal  @db.Decimal(18, 2)
  grossPay     Decimal  @db.Decimal(18, 2)
  totalDeductions Decimal @db.Decimal(18, 2)
  netPay       Decimal  @db.Decimal(18, 2)
  bankTransferCode String?
  status       PayslipStatus @default(DRAFT)
  employeeNotes String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  run      PayrollRun  @relation(fields: [runId], references: [id])
  employee Employee    @relation(fields: [employeeId], references: [id])
  items    PayrollItem[]

  @@index([tenantId, runId])
}

model SalaryComponent {
  id            String   @id @default(uuid())
  employeeId    String
  componentType String   // basic_salary, allowance, deduction
  amount        Decimal  @db.Decimal(18, 2)
  effectiveDate DateTime
  endDate       DateTime?
  createdAt     DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
}

model PayrollRunItem {
  id            String   @id @default(uuid())
  payrollRunId  String
  employeeId    String
  grossSalary   Decimal  @db.Decimal(18, 2) @default(0)
  netSalary     Decimal  @db.Decimal(18, 2) @default(0)
  status        String   @default("calculated") // calculated, exception
  createdAt     DateTime @default(now())

  run       PayrollRun                 @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee  Employee                   @relation(fields: [employeeId], references: [id])
  components PayrollRunItemComponent[]

  @@unique([payrollRunId, employeeId])
  @@index([payrollRunId])
}

model PayrollRunItemComponent {
  id                  String  @id @default(uuid())
  payrollRunItemId    String
  componentType       String  // basic, bpjs_kesehatan, bpjs_tk, pph21, loan_deduction
  amount              Decimal @db.Decimal(18, 2)

  item PayrollRunItem @relation(fields: [payrollRunItemId], references: [id], onDelete: Cascade)

  @@index([payrollRunItemId])
}

model BankTransferBatch {
  id           String   @id @default(uuid())
  payrollRunId String
  bankCode     String
  fileUrl      String
  status       String   @default("generated") // generated, submitted, confirmed, failed
  generatedAt  DateTime @default(now())

  run PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
}

model BpjsConfig {
  id             String   @id @default(uuid())
  tenantId       String
  type           BpjsType  // KES, KET
  jkmRate        Decimal   @db.Decimal(5, 4) // e.g. 0.003 (0.3%)
  jkkRate        Decimal   @db.Decimal(5, 4) // risk-based
  jhtEmployerRate Decimal  @db.Decimal(5, 4)
  jhtEmployeeRate Decimal  @db.Decimal(5, 4)
  pensionEmployerRate Decimal @db.Decimal(5, 4)
  pensionEmployeeRate Decimal @db.Decimal(5, 4)
  maxWageLimit   Decimal?  @db.Decimal(18, 2)
  effectiveDate  DateTime
  status         BpjsConfigStatus @default(ACTIVE)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([tenantId, type, effectiveDate])
}

model TaxConfig {
  id             String   @id @default(uuid())
  tenantId       String
  taxMethod      String   // TER, PROGRESSIVE, GROSS_UP
  ptkp           Decimal  @db.Decimal(18, 2) // PTKP amount
  terCategory    String?  // A, B, C for TER method
  effectiveDate  DateTime
  status         TaxConfigStatus @default(ACTIVE)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([tenantId, taxMethod, effectiveDate])
}

// =======================================================================
// RECRUITMENT & ONBOARDING
// =======================================================================

model JobRequisition {
  id            String   @id @default(uuid())
  tenantId      String
  title         String
  departmentId  String
  status        String   @default("pending_approval") // pending_approval, approved, rejected, closed
  approvedBy    String?
  createdAt     DateTime @default(now())

  department Department @relation(fields: [departmentId], references: [id])
  approver   Employee?  @relation("requisition_approver", fields: [approvedBy], references: [id])
  postings   JobPosting[]

  @@index([tenantId, status])
}

model JobPosting {
  id             String   @id @default(uuid())
  tenantId       String
  requisitionId  String?
  positionId     String
  title          String
  description    String
  requirements   String?
  responsibilities String?
  minSalary      Decimal? @db.Decimal(18, 2)
  maxSalary      Decimal? @db.Decimal(18, 2)
  employmentType String?  // FULL_TIME, PART_TIME, CONTRACT, INTERNSHIP
  location       String?
  slots          Int      @default(1)
  filledSlots    Int      @default(0)
  status         PostingStatus @default(DRAFT)
  postedAt       DateTime?
  closedAt       DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  applications  Application[]
  requisition   JobRequisition? @relation(fields: [requisitionId], references: [id])
}

model Candidate {
  id            String   @id @default(uuid())
  tenantId      String
  firstName     String
  lastName      String
  email         String
  phone         String?
  resumeUrl     String?
  source        String?  // LINKEDIN, JOBBOARD, REFERRAL, DIRECT
  currentCompany String?
  currentPosition String?
  notes         String?
  status        CandidateStatus @default(ACTIVE)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  applications Application[]
}

model Application {
  id            String   @id @default(uuid())
  tenantId      String
  jobPostingId  String
  candidateId   String
  employeeId    String? // converted from candidate
  status        ApplicationStatus @default(NEW)
  expectedSalary Decimal? @db.Decimal(18, 2)
  notes         String?
  appliedAt     DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  jobPosting JobPosting @relation(fields: [jobPostingId], references: [id])
  candidate  Candidate  @relation(fields: [candidateId], references: [id])
  employee   Employee?  @relation(fields: [employeeId], references: [id])
  interviews Interview[]
  offers     Offer[]
  onboardingDocuments OnboardingDocument[]
}

model Interview {
  id            String   @id @default(uuid())
  applicationId String
  stage         Int      @default(1)
  type          InterviewType // ONLINE, OFFLINE, PHONE
  interviewerId String
  scheduledAt   DateTime
  durationMinutes Int
  location      String?
  meetingLink   String?
  score         Decimal? @db.Decimal(5, 2)
  feedback      String?
  status        InterviewStatus @default(SCHEDULED)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  scorecards   InterviewScorecard[]
}

model InterviewScorecard {
  id           String @id @default(uuid())
  interviewId  String
  competency   String
  score        Int    // 1-5
  notes        String?

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@index([interviewId])
}

model Offer {
  id            String   @id @default(uuid())
  applicationId String
  version       Int      @default(1)
  baseSalary    Decimal  @db.Decimal(18, 2)
  allowance     Decimal? @db.Decimal(18, 2)
  benefitDescription String?
  joinDate      DateTime
  status        OfferStatus @default(DRAFT)
  sentAt        DateTime?
  acceptedAt    DateTime?
  rejectedAt    DateTime?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, version])
}

model OnboardingDocument {
  id            String   @id @default(uuid())
  applicationId String
  docType       String
  fileUrl       String
  uploadedAt    DateTime @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

// =======================================================================
// ASSET MANAGEMENT
// =======================================================================

model Asset {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  code        String
  category    AssetCategory // LAPTOP, PHONE, VEHICLE, CARD, OTHER
  brand       String?
  model       String?
  serialNumber String?
  purchaseDate DateTime?
  purchasePrice Decimal? @db.Decimal(18, 2)
  condition   AssetCondition @default(GOOD)
  status      AssetStatus @default(AVAILABLE)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  assignments AssetAssignment[]

  @@unique([tenantId, code])
}

model AssetAssignment {
  id          String   @id @default(uuid())
  assetId     String
  employeeId  String
  assignedAt  DateTime @default(now())
  returnedAt  DateTime?
  conditionOnReturn String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  asset    Asset    @relation(fields: [assetId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])
}

// =======================================================================
// EXPENSE CLAIM & LOAN MANAGEMENT
// =======================================================================

model ExpenseClaim {
  id            String   @id @default(uuid())
  tenantId      String
  employeeId    String
  title         String
  description   String?
  totalAmount   Decimal  @db.Decimal(18, 2)
  currency      String   @default("IDR")
  status        RequestStatus @default(PENDING)
  submittedAt   DateTime?
  approvedBy    String?
  approvedAt    DateTime?
  paidAt        DateTime?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])
  items    ExpenseItem[]
}

model ExpenseItem {
  id          String   @id @default(uuid())
  claimId     String
  category    ExpenseCategory // TRAVEL, MEAL, ENTERTAINMENT, OFFICE, OTHER
  description String
  amount      Decimal  @db.Decimal(18, 2)
  receiptUrl  String?
  date        DateTime?
  createdAt   DateTime @default(now())

  claim ExpenseClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
}

model Loan {
  id              String   @id @default(uuid())
  tenantId        String
  employeeId      String
  amount          Decimal  @db.Decimal(18, 2)
  installmentCount Int
  installmentAmount Decimal @db.Decimal(18, 2)
  purpose         String?
  status          RequestStatus @default(PENDING)
  approvedBy      String?
  approvedAt      DateTime?
  startDeductionFrom String? // payroll period
  remainingBalance Decimal @db.Decimal(18, 2)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  employee     Employee @relation(fields: [employeeId], references: [id])
  installments LoanInstallment[]
}

model LoanInstallment {
  id          String   @id @default(uuid())
  loanId      String
  periodName  String
  amount      Decimal  @db.Decimal(18, 2)
  status      InstallmentStatus @default(PENDING)
  paidAt      DateTime?
  payrollRunId String?
  createdAt   DateTime @default(now())

  loan Loan @relation(fields: [loanId], references: [id], onDelete: Cascade)
}

// =======================================================================
// BENEFIT MANAGEMENT
// =======================================================================

model Benefit {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  code        String
  type        BenefitType // ALLOWANCE, INSURANCE, FACILITY, OTHER
  description String?
  isTaxable   Boolean  @default(true)
  value       Decimal? @db.Decimal(18, 2)
  frequency   String?  // MONTHLY, YEARLY, ONE_TIME
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  employeeBenefits EmployeeBenefit[]
  eligibilityRules  BenefitEligibilityRule[]
}

model EmployeeBenefit {
  id          String   @id @default(uuid())
  tenantId    String
  employeeId  String
  benefitId   String
  value       Decimal? @db.Decimal(18, 2)
  effectiveDate DateTime @default(now())
  expiryDate  DateTime?
  status      BenefitStatus @default(ACTIVE)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employee   Employee @relation(fields: [employeeId], references: [id])
  benefit    Benefit  @relation(fields: [benefitId], references: [id])
  components EmployeeBenefitComponent[]
}

model EmployeeBenefitComponent {
  id              String @id @default(uuid())
  employeeBenefitId String
  payrollComponentId String
  amount          Decimal @db.Decimal(18, 2)

  employeeBenefit  EmployeeBenefit  @relation(fields: [employeeBenefitId], references: [id], onDelete: Cascade)
  payrollComponent PayrollComponent @relation(fields: [payrollComponentId], references: [id])
}

// =======================================================================
// PERFORMANCE MANAGEMENT
// =======================================================================

model ReviewCycle {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  period      String   // Q1_2026, H1_2026, YEARLY_2026
  startDate   DateTime
  endDate     DateTime
  type        ReviewCycleType // QUARTERLY, SEMI_ANNUAL, ANNUAL
  status      CycleStatus @default(UPCOMING)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reviews           PerformanceReview[]
  calibrationSessions CalibrationSession[]
  finalScores         FinalScore[]
}

model PerformanceReview {
  id           String   @id @default(uuid())
  tenantId     String
  cycleId      String
  employeeId   String
  reviewerId   String
  overallScore Decimal? @db.Decimal(5, 2)
  summary      String?
  strengths    String?
  improvements String?
  status       ReviewStatus @default(PENDING)
  submittedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  cycle    ReviewCycle @relation(fields: [cycleId], references: [id])
  employee Employee   @relation(fields: [employeeId], references: [id])
  ratings  Rating[]
  goals    Goal[]
}

model Rating {
  id               String   @id @default(uuid())
  reviewId         String
  competency       String
  score            Decimal  @db.Decimal(5, 2)
  description      String?
  createdAt        DateTime @default(now())

  review PerformanceReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
}

model Goal {
  id          String   @id @default(uuid())
  tenantId    String
  employeeId  String
  reviewId    String?
  title       String
  description String?
  metric      String?
  targetValue Decimal? @db.Decimal(18, 2)
  actualValue Decimal? @db.Decimal(18, 2)
  startDate   DateTime?
  endDate     DateTime?
  status      GoalStatus @default(NOT_STARTED)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])
  review   PerformanceReview? @relation(fields: [reviewId], references: [id])
}

model CalibrationSession {
  id            String   @id @default(uuid())
  reviewCycleId String
  departmentId  String
  facilitatorId String
  status        String   @default("scheduled") // scheduled, in_progress, finalized
  createdAt     DateTime @default(now())

  cycle       ReviewCycle @relation(fields: [reviewCycleId], references: [id], onDelete: Cascade)
  department  Department  @relation(fields: [departmentId], references: [id])
  facilitator Employee    @relation("calibration_facilitator", fields: [facilitatorId], references: [id])
}

model FinalScore {
  id            String   @id @default(uuid())
  employeeId    String
  reviewCycleId String
  finalRating   Decimal  @db.Decimal(3, 1)
  calibratedBy  String
  finalizedAt   DateTime @default(now())

  employee    Employee    @relation(fields: [employeeId], references: [id])
  cycle       ReviewCycle @relation(fields: [reviewCycleId], references: [id], onDelete: Cascade)
  calibrator  Employee    @relation("final_score_calibrator", fields: [calibratedBy], references: [id])
  movementRequests MovementRequest[] @relation("movement_performance_ref")

  @@unique([employeeId, reviewCycleId])
}

// =======================================================================
// LEARNING MANAGEMENT
// =======================================================================

model Training {
  id            String   @id @default(uuid())
  tenantId      String
  title         String
  description   String?
  type          TrainingType // INTERNAL, EXTERNAL, ONLINE, CERTIFICATION
  provider      String?
  startDate     DateTime
  endDate       DateTime
  cost          Decimal? @db.Decimal(18, 2)
  capacity      Int?
  status        TrainingStatus @default(PLANNED)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  participants TrainingParticipant[]
}

model TrainingParticipant {
  id          String   @id @default(uuid())
  trainingId  String
  employeeId  String
  status      ParticipantStatus @default(REGISTERED)
  score       Decimal? @db.Decimal(5, 2)
  completedAt DateTime?
  feedback    String?
  createdAt   DateTime @default(now())

  training Training @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([trainingId, employeeId])
}

model Certification {
  id            String   @id @default(uuid())
  tenantId      String
  employeeId    String
  name          String
  issuer        String?
  issuedDate    DateTime
  expiryDate    DateTime?
  certificateUrl String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])
}

// =======================================================================
// RESIGNATION & OFFBOARDING
// =======================================================================

model ResignationRequest {
  id              String   @id @default(uuid())
  tenantId        String
  employeeId      String
  type            ResignationType @default(RESIGNATION) // RESIGNATION, RETIREMENT, TERMINATION
  reason          String
  resignationDate DateTime
  effectiveDate   DateTime
  status          RequestStatus @default(PENDING)
  approvedBy      String?
  approvedAt      DateTime?
  rejectedReason  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  employee      Employee @relation(fields: [employeeId], references: [id])
  exitInterview ExitInterview?
  offboardingTasks OffboardingTask[]
  finalSettlement FinalSettlement?
}

model ExitInterview {
  id                  String   @id @default(uuid())
  resignationId       String @unique
  reason              String
  feedback            String?
  wouldRecommend      Boolean?
  areasForImprovement String?
  conductedBy         String
  conductedAt         DateTime
  createdAt           DateTime @default(now())

  resignation ResignationRequest @relation(fields: [resignationId], references: [id], onDelete: Cascade)
}

model OffboardingTask {
  id              String   @id @default(uuid())
  resignationId   String
  taskName        String
  assignedTo      String
  category        OffboardingCategory @default(ASSET)
  status          TaskStatus @default(PENDING)
  completedAt     DateTime?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  resignation ResignationRequest @relation(fields: [resignationId], references: [id], onDelete: Cascade)
}

model FinalSettlement {
  id               String   @id @default(uuid())
  resignationId    String   @unique
  unusedLeavePayout Decimal  @db.Decimal(18, 2) @default(0)
  severanceAmount  Decimal  @db.Decimal(18, 2) @default(0)
  loanDeduction    Decimal  @db.Decimal(18, 2) @default(0)
  netPayout        Decimal  @db.Decimal(18, 2) @default(0)
  status           String   @default("draft") // draft, reviewed, paid
  createdAt        DateTime @default(now())

  resignation ResignationRequest @relation(fields: [resignationId], references: [id], onDelete: Cascade)
}

model MovementRequest {
  id                     String   @id @default(uuid())
  employeeId             String
  type                   String   // promotion, transfer, mutation
  newPositionId          String?
  newDepartmentId        String?
  effectiveDate          DateTime
  status                 String   @default("pending") // pending, approved, rejected
  performanceReviewRefId String?  // FK to FinalScore
  createdAt              DateTime @default(now())

  employee          Employee   @relation(fields: [employeeId], references: [id])
  newPosition       Position?  @relation(fields: [newPositionId], references: [id])
  newDepartment     Department? @relation(fields: [newDepartmentId], references: [id])
  performanceReview FinalScore? @relation("movement_performance_ref", fields: [performanceReviewRefId], references: [id])

  @@index([employeeId])
}

model BenefitEligibilityRule {
  id            String @id @default(uuid())
  benefitId     String
  gradeId       String?
  departmentId  String?
  createdAt     DateTime @default(now())

  benefit    Benefit    @relation(fields: [benefitId], references: [id], onDelete: Cascade)
  grade      Grade?     @relation(fields: [gradeId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])
}

model EssNotification {
  id         String   @id @default(uuid())
  employeeId String
  type       String
  message    String
  readStatus Boolean  @default(false)
  createdAt  DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId, readStatus])
}

model EssOnboardingProgress {
  id                   String    @id @default(uuid())
  employeeId           String     @unique
  tourCompleted        Boolean    @default(false)
  profileConfirmedAt   DateTime?

  employee Employee @relation(fields: [employeeId], references: [id])
}

model EssPreference {
  id                   String @id @default(uuid())
  employeeId           String  @unique
  language             String  @default("id")
  theme                String  @default("light")
  notificationSettings Json    @default("{}")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])
}

