model LeaveType {
  id                   String   @id @default(uuid())
  tenantId             String
  name                 String
  code                 String
  description          String?
  isPaid               Boolean  @default(true)
  allowNegativeBalance Boolean  @default(false)
  maxConsecutiveDays   Int?
  requiresDocument     Boolean  @default(false)
  carryForwardLimit    Int?     @default(0)
  carryForwardExpiry   String? // e.g. "Q1_NEXT_YEAR"
  genderRestriction    Gender?
  minServiceMonths     Int?
  isBalanceDeducting   Boolean  @default(true) // Addendum v1.2: CUTI (true) vs IZIN (false)
  sameDayApproval      Boolean  @default(false) // Addendum v1.2 FR-19: Cuti Haid dapat diajukan hari-H tanpa pre-approval
  isUnionActivity      Boolean  @default(false) // Addendum Serikat Pekerja: izin kegiatan serikat (BR-01: officer only)
