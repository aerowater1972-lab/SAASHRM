model ViolationCategory {
  id          String    @id @default(uuid())
  tenantId    String
  name        String
  code        String
  description String?
  severity    Int       @default(1) // 1=MILD, 2=MODERATE, 3=SEVERE
  canSkipSP1  Boolean   @default(false) // pelanggaran berat → langsung SP2/SP3
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  tenant               Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  disciplinaryCases    DisciplinaryCase[]
  recommendedTrainings Training[]         @relation("recommended_k3_training")

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
}

model DisciplinaryCase {
  id                  String             @id @default(uuid())
  tenantId            String
  employeeId          String
  violationCategoryId String
  spLevel             SpLevel
  description         String
  issuedDate          DateTime           @default(now())
  validUntil          DateTime?
  status              DisciplinaryStatus @default(DRAFT)
  approvedById        String?
  acknowledgedAt      DateTime?
  escalatedAt         DateTime? // BR-05: otomatis jika >3 hari tidak diakui
  escalatedToId       String? // atasan / HR yang dieskalasi
  notes               String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  deletedAt           DateTime?

  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  employee          Employee          @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  violationCategory ViolationCategory @relation(fields: [violationCategoryId], references: [id], onDelete: Restrict)
  approvedBy        User?             @relation("approved_disciplinary", fields: [approvedById], references: [id], onDelete: SetNull)
  escalatedTo       User?             @relation("escalated_disciplinary", fields: [escalatedToId], references: [id], onDelete: SetNull)

  @@index([tenantId, employeeId])
  @@index([tenantId, status])
  @@index([tenantId, issuedDate])
}

model IncidentReport {
  id                      String           @id @default(uuid())
  tenantId                String
  employeeId              String // pelapor
  location                String
  incidentDate            DateTime
  severity                IncidentSeverity
  category                IncidentCategory
  description             String
  reportedById            String?
  status                  IncidentStatus   @default(REPORTED)
  authorityReportDeadline DateTime?
  authorityReportedAt     DateTime?
  resolutionNotes         String?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
  deletedAt               DateTime?

  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  reportedBy User?    @relation("reported_incidents", fields: [reportedById], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([tenantId, severity])
  @@index([tenantId, incidentDate])
}

model PpeAssignment {
