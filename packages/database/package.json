{
  "name": "@flexy-hrms/database",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "db:generate": "prisma generate --schema=./schema.prisma",
    "db:migrate": "prisma migrate dev --schema=./schema.prisma",
    "db:push": "prisma db push --schema=./schema.prisma",
    "db:seed": "prisma db seed --schema=./schema.prisma",
    "db:seed:demo": "ts-node ./seed-demo-nusantara.ts",
    "db:seed:features": "ts-node ./seed-new-features.ts",
    "db:studio": "prisma studio --schema=./schema.prisma"
  },
  "devDependencies": {
    "prisma": "^6.6.0"
  },
  "dependencies": {
    "@prisma/client": "^6.6.0"
  },
  "prisma": {
    "schema": "./schema.prisma"
  }
}
