# Flexy HRMS Backend — Environment Variables Example
# Salin ke .env dan sesuaikan sebelum menjalankan `npm run start:dev`.

# Database (lihat docker-compose.yml untuk kredensial default lokal)
DATABASE_URL="postgresql://flexy:flexy_dev_password@localhost:5432/flexy_hrms?schema=public"

# Redis (cache Authz + BullMQ queue Audit Log)
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET="change-me-in-production-use-a-long-random-string"

PORT=3000
NODE_ENV=development
